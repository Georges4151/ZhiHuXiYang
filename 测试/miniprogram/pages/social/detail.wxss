/* 适老化设计 - 动态详情页 */
.detail-container {
  min-height: 100vh;
  background: linear-gradient(180deg, #f8f9fa 0%, #f0f4f8 100%);
  padding-bottom: 140rpx;
}

/* 动态详情卡片 */
.post-detail {
  background: #fff;
  padding: 36rpx;
  margin-bottom: 24rpx;
  border-bottom: 2rpx solid #e8e8e8;
}

/* 用户信息 - 大头像 */
.user-info {
  display: flex;
  align-items: center;
  margin-bottom: 28rpx;
}

.avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  margin-right: 24rpx;
  border: 4rpx solid #e8f4fd;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.1);
}

.user-meta {
  flex: 1;
}

.user-name {
  font-size: 38rpx;
  font-weight: bold;
  color: #333;
  display: block;
  margin-bottom: 8rpx;
}

.post-time {
  font-size: 32rpx;
  color: #999;
  display: block;
}

/* 分类标签 */
.category-tag {
  display: inline-block;
  padding: 8rpx 20rpx;
  background: linear-gradient(135deg, #e8f4fd 0%, #d4e9f7 100%);
  color: #4A90D9;
  font-size: 28rpx;
  border-radius: 20rpx;
  margin-bottom: 16rpx;
  font-weight: 500;
}

/* 动态内容 - 大字体 */
.post-content {
  margin-bottom: 28rpx;
}

.content-text {
  font-size: 36rpx;
  color: #333;
  line-height: 1.8;
  display: block;
  margin-bottom: 24rpx;
  letter-spacing: 1rpx;
}

/* 图片列表 */
.image-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.post-image {
  width: 200rpx;
  height: 200rpx;
  border-radius: 16rpx;
  object-fit: cover;
  border: 2rpx solid #f0f0f0;
}

.post-image.single {
  width: 100%;
  height: 480rpx;
}

/* 互动按钮 - 大按钮 */
.post-actions {
  display: flex;
  border-top: 2rpx solid #f0f0f0;
  padding-top: 24rpx;
}

.action-item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  padding: 20rpx 0;
  border-radius: 12rpx;
  transition: all 0.3s ease;
}

.action-item:active {
  background: #f5f5f5;
}

.action-icon {
  width: 48rpx;
  height: 48rpx;
  font-size: 44rpx;
}

.action-icon.liked {
  color: #ff4d4f;
}

.count {
  font-size: 32rpx;
  color: #666;
  font-weight: 500;
}

/* 分享按钮样式 */
.share-btn {
  background: none;
  border: none;
  padding: 0;
  margin: 0;
  line-height: inherit;
  font-size: inherit;
  color: inherit;
}

.share-btn::after {
  border: none;
}

/* 评论区域 */
.comments-section {
  background: #fff;
  padding: 36rpx;
  min-height: 400rpx;
}

.section-title {
  display: flex;
  align-items: center;
  margin-bottom: 28rpx;
  padding-bottom: 20rpx;
  border-bottom: 2rpx solid #f0f0f0;
}

.title-text {
  font-size: 38rpx;
  font-weight: bold;
  color: #333;
}

.count-badge {
  margin-left: 16rpx;
  padding: 4rpx 16rpx;
  background: linear-gradient(135deg, #4A90D9 0%, #357ABD 100%);
  color: #fff;
  font-size: 28rpx;
  border-radius: 20rpx;
  font-weight: 500;
}

/* 评论列表 */
.comment-list {
  padding-bottom: 24rpx;
}

.comment-item {
  display: flex;
  padding: 24rpx 0;
  border-bottom: 2rpx solid #f5f5f5;
}

.comment-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  margin-right: 20rpx;
  border: 2rpx solid #e8f4fd;
}

.comment-content {
  flex: 1;
}

.comment-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.comment-name {
  font-size: 34rpx;
  font-weight: bold;
  color: #333;
}

.comment-time {
  font-size: 28rpx;
  color: #999;
}

.comment-text {
  font-size: 32rpx;
  color: #666;
  line-height: 1.6;
}

/* 空评论状态 */
.empty-comments {
  text-align: center;
  padding: 60rpx 32rpx;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
  display: block;
}

.empty-text {
  font-size: 32rpx;
  color: #999;
}

/* 评论输入框 */
.comment-input-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  padding: 20rpx 24rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  border-top: 2rpx solid #e8e8e8;
  display: flex;
  align-items: center;
  gap: 20rpx;
  box-shadow: 0 -4rpx 12rpx rgba(0,0,0,0.05);
}

.comment-input {
  flex: 1;
  height: 80rpx;
  background: #f5f5f5;
  border-radius: 40rpx;
  padding: 0 32rpx;
  font-size: 32rpx;
  color: #333;
}

.comment-input::placeholder {
  color: #999;
  font-size: 32rpx;
}

.send-btn {
  width: 140rpx;
  height: 80rpx;
  background: #ccc;
  color: #fff;
  font-size: 32rpx;
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  transition: all 0.3s ease;
}

.send-btn.active {
  background: linear-gradient(135deg, #4A90D9 0%, #357ABD 100%);
}

.send-btn[disabled] {
  background: #ccc;
}

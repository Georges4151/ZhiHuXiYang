<view class="social-container">
  <view class="category-tabs">
    <view 
      wx:for="{{categories}}" 
      wx:key="id"
      class="tab-item {{category === item.id ? 'active' : ''}}"
      data-id="{{item.id}}"
      bindtap="onCategoryChange"
    >
      {{item.name}}
    </view>
  </view>

  <view class="post-list">
    <view class="post-item" wx:for="{{posts}}" wx:key="id">
      <view class="user-info">
        <view class="avatar" style="background: linear-gradient(135deg, #4A90D9 0%, #357ABD 100%);">
          <text class="avatar-text">{{item.userName.charAt(0)}}</text>
        </view>
        <view class="user-meta">
          <text class="user-name">{{item.userName}}</text>
          <text class="post-time">{{item.createdAt}}</text>
        </view>
      </view>

      <view class="category-tag" wx:if="{{item.category}}">
        {{item.categoryName}}
      </view>

      <view class="post-content">
        <text class="content-text">{{item.content}}</text>
        <view class="image-list" wx:if="{{item.images && item.images !== ''}}">
          <image 
            wx:for="{{item.images.split(',')}}" 
            wx:for-item="img"
            wx:key="*this"
            class="post-image {{item.images.split(',').length === 1 ? 'single' : ''}}"
            src="{{img}}"
            mode="aspectFill"
            data-urls="{{item.images.split(',')}}"
            data-current="{{img}}"
            bindtap="onImagePreview"
          />
        </view>
      </view>

      <view class="post-actions">
        <view class="action-item" data-id="{{item.id}}" data-index="{{index}}" bindtap="onLike">
          <view class="action-icon-wrap {{item.isLiked ? 'liked' : ''}}" style="background: {{item.isLiked ? 'linear-gradient(135deg, #F56C6C 0%, #E64545 100%)' : 'linear-gradient(135deg, #ddd 0%, #ccc 100%)'}}">
            <text class="action-icon-text">{{item.isLiked ? '赞' : '赞'}}</text>
          </view>
          <text class="count">{{item.likes || 0}}</text>
        </view>
        <view class="action-item" data-id="{{item.id}}" bindtap="onComment">
          <view class="action-icon-wrap" style="background: linear-gradient(135deg, #4A90D9 0%, #357ABD 100%);">
            <text class="action-icon-text">评</text>
          </view>
          <text class="count">{{item.comments || 0}}</text>
        </view>
        <button class="action-item share-btn" open-type="share" data-id="{{item.id}}" data-content="{{item.content}}">
          <view class="action-icon-wrap" style="background: linear-gradient(135deg, #67C23A 0%, #4A9F29 100%);">
            <text class="action-icon-text">享</text>
          </view>
          <text class="count">分享</text>
        </button>
      </view>
    </view>
  </view>

  <view class="loading-more" wx:if="{{loading}}">
    <text>加载中...</text>
  </view>
  <view class="no-more" wx:if="{{!hasMore && posts.length > 0}}">
    <text>没有更多了</text>
  </view>
  
  <view class="empty" wx:if="{{posts.length === 0 && !loading}}">
    <view class="empty-icon-wrap">
      <text class="empty-icon-text">空</text>
    </view>
    <text class="empty-text">暂无动态，快来发布第一条吧！</text>
    <view class="hint-text">点击右下角按钮发布您的第一条动态</view>
  </view>

  <view class="publish-btn" bindtap="onPublish">
    <text class="plus">+</text>
  </view>
</view>

/* 适老化设计 - 社交圈子 */
/* 设计原则：大字体、高对比度、高识别度、温馨风格 */

.social-container {
  min-height: 100vh;
  background: linear-gradient(180deg, #f0f7ff 0%, #ffffff 50%, #f8faff 100%);
  padding-bottom: 200rpx;
}

/* 分类标签 - 大字体高对比 */
.category-tabs {
  display: flex;
  background: #fff;
  padding: 24rpx 20rpx;
  position: sticky;
  top: 0;
  z-index: 100;
  border-bottom: 2rpx solid #e8e8e8;
  box-shadow: 0 6rpx 16rpx rgba(0,0,0,0.08);
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 24rpx 18rpx;
  font-size: 36rpx;
  color: #666;
  position: relative;
  border-radius: 16rpx;
  margin: 0 10rpx;
  background: #f5f5f5;
  transition: all 0.3s ease;
  font-weight: 600;
}

.tab-item.active {
  color: #fff;
  font-weight: 700;
  background: linear-gradient(135deg, #4A90D9 0%, #357ABD 100%);
  box-shadow: 0 6rpx 20rpx rgba(74,144,217,0.4);
}

.tab-item:active {
  transform: scale(0.96);
}

/* 动态列表 */
.post-list {
  padding: 28rpx;
}

.post-item {
  background: #fff;
  border-radius: 32rpx;
  padding: 40rpx;
  margin-bottom: 32rpx;
  box-shadow: 0 8rpx 28rpx rgba(0,0,0,0.1);
  border: 2rpx solid #f0f0f0;
}

/* 用户信息 - 大头像 */
.user-info {
  display: flex;
  align-items: center;
  margin-bottom: 32rpx;
  padding-bottom: 24rpx;
  border-bottom: 2rpx solid #f0f0f0;
}

.avatar {
  width: 110rpx;
  height: 110rpx;
  border-radius: 50%;
  margin-right: 28rpx;
  border: 5rpx solid #e8f4fd;
  box-shadow: 0 6rpx 20rpx rgba(0,0,0,0.12);
}

.user-meta {
  flex: 1;
}

.user-name {
  font-size: 40rpx;
  font-weight: 700;
  color: #1a1a1a;
  display: block;
  margin-bottom: 10rpx;
  letter-spacing: 1rpx;
}

.post-time {
  font-size: 34rpx;
  color: #666;
  display: block;
}

/* 分类标签 */
.category-tag {
  display: inline-block;
  padding: 10rpx 24rpx;
  background: linear-gradient(135deg, #e8f4fd 0%, #d4e9f7 100%);
  color: #4A90D9;
  font-size: 30rpx;
  border-radius: 24rpx;
  margin-bottom: 20rpx;
  font-weight: 600;
}

/* 动态内容 - 大字体 */
.post-content {
  margin-bottom: 32rpx;
}

.content-text {
  font-size: 38rpx;
  color: #1a1a1a;
  line-height: 1.9;
  display: block;
  margin-bottom: 28rpx;
  letter-spacing: 1rpx;
}

/* 图片列表 */
.image-list {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.post-image {
  width: 220rpx;
  height: 220rpx;
  border-radius: 20rpx;
  object-fit: cover;
  border: 3rpx solid #f0f0f0;
}

.post-image.single {
  width: 100%;
  height: 500rpx;
}

/* 互动按钮 - 大按钮 */
.post-actions {
  display: flex;
  border-top: 2rpx solid #f0f0f0;
  padding-top: 28rpx;
}

.action-item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 18rpx;
  padding: 24rpx 0;
  border-radius: 16rpx;
  transition: all 0.3s ease;
}

.action-item:active {
  background: #f5f7ff;
}

.action-icon {
  width: 52rpx;
  height: 52rpx;
  font-size: 48rpx;
}

.action-icon.liked {
  color: #F56C6C;
}

.count {
  font-size: 34rpx;
  color: #444;
  font-weight: 600;
}

/* 分享按钮样式 */
.share-btn {
  background: none;
  border: none;
  padding: 0;
  margin: 0;
  line-height: inherit;
  font-size: inherit;
  color: inherit;
}

.share-btn::after {
  border: none;
}

/* 加载更多 */
.loading-more, .no-more {
  text-align: center;
  padding: 52rpx 36rpx;
  color: #666;
  font-size: 38rpx;
}

/* 空状态 */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 140rpx 80rpx;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 36rpx;
  opacity: 0.7;
}

.empty-text {
  font-size: 38rpx;
  color: #555;
  font-weight: 600;
  text-align: center;
}

.hint-text {
  font-size: 34rpx;
  color: #888;
  margin-top: 20rpx;
  text-align: center;
}

/* 发布按钮 - 大按钮醒目 */
.publish-btn {
  position: fixed;
  right: 48rpx;
  bottom: 160rpx;
  width: 150rpx;
  height: 150rpx;
  background: linear-gradient(135deg, #4A90D9 0%, #357ABD 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 10rpx 32rpx rgba(74,144,217,0.5);
  z-index: 1000;
  transition: all 0.3s ease;
}

.publish-btn:active {
  transform: scale(0.95);
  box-shadow: 0 6rpx 20rpx rgba(74,144,217,0.4);
}

.plus {
  font-size: 80rpx;
  color: #fff;
  font-weight: bold;
}

.groups-container {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 120rpx;
}

/* 分类标签 */
.category-scroll {
  background: #fff;
  white-space: nowrap;
  border-bottom: 1rpx solid #eee;
}

.category-tabs {
  display: inline-flex;
  padding: 20rpx;
}

.tab-item {
  padding: 16rpx 32rpx;
  font-size: 28rpx;
  color: #666;
  border-radius: 32rpx;
  margin-right: 20rpx;
  background: #f5f5f5;
}

.tab-item.active {
  color: #fff;
  background: #1890ff;
  font-weight: bold;
}

/* 小组列表 */
.group-list {
  padding: 20rpx;
}

.group-item {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.05);
}

.group-cover {
  width: 120rpx;
  height: 120rpx;
  border-radius: 16rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.group-info {
  flex: 1;
  min-width: 0;
}

.group-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  display: block;
  margin-bottom: 10rpx;
}

.group-desc {
  font-size: 26rpx;
  color: #666;
  display: block;
  margin-bottom: 10rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.group-meta {
  display: flex;
  gap: 20rpx;
}

.member-count, .post-count {
  font-size: 24rpx;
  color: #999;
}

.join-btn {
  margin-left: 20rpx;
  background: #1890ff;
  color: #fff;
  border-radius: 30rpx;
  padding: 10rpx 30rpx;
  font-size: 26rpx;
  flex-shrink: 0;
}

.join-btn.joined {
  background: #f5f5f5;
  color: #999;
}

/* 加载更多 */
.loading-more, .no-more, .empty {
  text-align: center;
  padding: 40rpx;
  color: #999;
  font-size: 28rpx;
}

/* 创建按钮 */
.create-btn {
  position: fixed;
  right: 40rpx;
  bottom: 120rpx;
  background: linear-gradient(135deg, #1890ff, #36cfc9);
  border-radius: 50rpx;
  padding: 20rpx 40rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
  box-shadow: 0 8rpx 20rpx rgba(24,144,255,0.4);
  z-index: 1000;
}

.plus {
  font-size: 40rpx;
  color: #fff;
  font-weight: bold;
}

.text {
  font-size: 28rpx;
  color: #fff;
}

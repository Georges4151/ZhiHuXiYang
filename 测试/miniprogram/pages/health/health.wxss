/* 健康页面样式 - 适老化设计版本 */
/* 设计原则：大字体、高对比度、高识别度、温馨风格 */

.container {
  min-height: 100vh;
  background: linear-gradient(180deg, #f0f7ff 0%, #ffffff 50%, #f8faff 100%);
  padding-bottom: 80rpx;
}

/* 头部区域 - 更醒目 */
.header {
  position: relative;
}

.header-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 280rpx;
  background: linear-gradient(135deg, #43D97C 0%, #38F9D7 50%, #30CFD0 100%);
  border-radius: 0 0 48rpx 48rpx;
  box-shadow: 0 12rpx 48rpx rgba(67, 217, 124, 0.35);
}

.header-bg::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100"><circle cx="85" cy="15" r="45" fill="rgba(255,255,255,0.12)"/><circle cx="15" cy="85" r="35" fill="rgba(255,255,255,0.08)"/></svg>');
  background-size: 220rpx;
  opacity: 0.6;
}

.header-content {
  position: relative;
  padding: 70rpx 40rpx 40rpx;
  color: #fff;
}

.header-title {
  font-size: 48rpx;
  font-weight: 700;
  display: block;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.15);
  letter-spacing: 2rpx;
}

.header-desc {
  font-size: 30rpx;
  color: rgba(255, 255, 255, 0.95);
  margin-top: 14rpx;
  display: block;
  font-weight: 500;
}

/* 标签页 - 大触摸区域 */
.tabs {
  display: flex;
  background: #fff;
  margin: -30rpx 32rpx 32rpx;
  border-radius: 28rpx;
  padding: 14rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.1);
  position: relative;
  z-index: 1;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 28rpx 0;
  font-size: 36rpx;
  color: #666;
  border-radius: 24rpx;
  transition: all 0.3s ease;
  font-weight: 600;
}

.tab-item:active {
  transform: scale(0.96);
}

.tab-item.active {
  background: linear-gradient(135deg, #43D97C 0%, #38F9D7 100%);
  color: #fff;
  font-weight: 700;
  box-shadow: 0 8rpx 28rpx rgba(67, 217, 124, 0.4);
}

.content {
  padding: 0 32rpx;
}

/* 健康概览 - 大卡片 */
.health-overview {
  background: #fff;
  border-radius: 32rpx;
  padding: 40rpx;
  box-shadow: 0 10rpx 36rpx rgba(0, 0, 0, 0.08);
}

.overview-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 32rpx;
}

.overview-title {
  font-size: 38rpx;
  font-weight: 700;
  color: #1a1a1a;
  position: relative;
  padding-left: 28rpx;
  letter-spacing: 1rpx;
}

.overview-title::before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 10rpx;
  height: 36rpx;
  background: linear-gradient(180deg, #43D97C 0%, #38F9D7 100%);
  border-radius: 5rpx;
}

.overview-time {
  font-size: 30rpx;
  color: #666;
  font-weight: 500;
}

.health-cards {
  display: flex;
  flex-wrap: wrap;
  gap: 28rpx;
}

.health-card {
  width: calc(50% - 14rpx);
  background: linear-gradient(135deg, #f8faff 0%, #f0f7ff 100%);
  border-radius: 28rpx;
  padding: 32rpx;
  position: relative;
  overflow: hidden;
  box-shadow: 0 6rpx 20rpx rgba(0, 0, 0, 0.06);
  transition: all 0.3s ease;
  min-height: 180rpx;
}

.health-card:active {
  transform: translateY(-6rpx);
  box-shadow: 0 12rpx 32rpx rgba(0, 0, 0, 0.12);
}

.health-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  width: 10rpx;
  height: 100%;
}

.health-card.bp::before { background: linear-gradient(180deg, #F56C6C 0%, #E64545 100%); }
.health-card.hr::before { background: linear-gradient(180deg, #F59E0B 0%, #FBBF24 100%); }
.health-card.bs::before { background: linear-gradient(180deg, #43D97C 0%, #38F9D7 100%); }
.health-card.wt::before { background: linear-gradient(180deg, #4A90D9 0%, #357ABD 100%); }

.card-header {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.card-icon {
  font-size: 42rpx;
  margin-right: 14rpx;
}

.card-label {
  font-size: 36rpx;
  color: #555;
  font-weight: 600;
}

.card-value-wrap {
  display: flex;
  align-items: baseline;
}

.card-value {
  font-size: 60rpx;
  font-weight: 700;
  color: #1a1a1a;
}

.card-divider {
  font-size: 46rpx;
  color: #888;
  margin: 0 12rpx;
}

.card-value-low {
  font-size: 46rpx;
  font-weight: 700;
  color: #1a1a1a;
}

.card-unit {
  font-size: 30rpx;
  color: #666;
  display: block;
  margin-top: 12rpx;
  font-weight: 500;
}

.card-status {
  position: absolute;
  top: 28rpx;
  right: 28rpx;
  padding: 10rpx 20rpx;
  border-radius: 24rpx;
  font-size: 26rpx;
  font-weight: 700;
}

.card-status.normal {
  background: linear-gradient(135deg, #d1fae5 0%, #a7f3d0 100%);
  color: #059669;
}

.card-status.warning {
  background: linear-gradient(135deg, #fef3c7 0%, #fde68a 100%);
  color: #D97706;
}

/* 健康提示 - 大字体 */
.tips-section {
  background: #fff;
  border-radius: 32rpx;
  padding: 40rpx;
  margin-top: 28rpx;
  box-shadow: 0 10rpx 36rpx rgba(0, 0, 0, 0.08);
}

.section-title {
  font-size: 38rpx;
  font-weight: 700;
  color: #1a1a1a;
  margin-bottom: 28rpx;
  position: relative;
  padding-left: 28rpx;
  letter-spacing: 1rpx;
}

.section-title::before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 10rpx;
  height: 36rpx;
  background: linear-gradient(180deg, #43D97C 0%, #38F9D7 100%);
  border-radius: 5rpx;
}

.tips-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.tip-item {
  display: flex;
  align-items: flex-start;
  padding: 24rpx 28rpx;
  background: linear-gradient(135deg, #f0fdf4 0%, #ecfdf5 100%);
  border-radius: 24rpx;
  transition: all 0.2s ease;
}

.tip-item:active {
  background: linear-gradient(135deg, #dcfce7 0%, #d1fae5 100%);
}

.tip-icon {
  font-size: 36rpx;
  margin-right: 18rpx;
  flex-shrink: 0;
}

.tip-text {
  font-size: 34rpx;
  color: #444;
  line-height: 1.7;
  font-weight: 500;
}

/* 添加按钮 - 大尺寸 */
.add-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 36rpx;
  height: 112rpx;
  background: linear-gradient(135deg, #43D97C 0%, #38F9D7 100%);
  color: #fff;
  font-size: 36rpx;
  font-weight: 700;
  border-radius: 32rpx;
  box-shadow: 0 10rpx 36rpx rgba(67, 217, 124, 0.4);
  transition: all 0.3s ease;
  letter-spacing: 1rpx;
}

.add-btn:active {
  transform: translateY(4rpx);
  box-shadow: 0 6rpx 20rpx rgba(67, 217, 124, 0.3);
}

.analyze-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 28rpx;
  height: 112rpx;
  background: linear-gradient(135deg, #4A90D9 0%, #357ABD 100%);
  color: #fff;
  font-size: 36rpx;
  font-weight: 700;
  border-radius: 32rpx;
  box-shadow: 0 10rpx 36rpx rgba(74, 144, 217, 0.4);
  transition: all 0.3s ease;
  letter-spacing: 1rpx;
}

.analyze-btn:active {
  transform: translateY(4rpx);
  box-shadow: 0 6rpx 20rpx rgba(74, 144, 217, 0.3);
}

.btn-icon {
  margin-right: 14rpx;
  font-size: 40rpx;
}

/* 历史记录 - 大字体 */
.history-section {
  background: #fff;
  border-radius: 32rpx;
  padding: 40rpx;
  box-shadow: 0 10rpx 36rpx rgba(0, 0, 0, 0.08);
}

.history-item {
  padding: 32rpx 0;
  border-bottom: 2rpx solid #f0f0f0;
  transition: all 0.2s ease;
}

.history-item:active {
  background: #f8faff;
  margin: 0 -24rpx;
  padding-left: 24rpx;
  padding-right: 24rpx;
  border-radius: 20rpx;
}

.history-item:last-child {
  border-bottom: none;
}

.history-date {
  font-size: 34rpx;
  font-weight: 700;
  color: #1a1a1a;
  margin-bottom: 24rpx;
}

.history-data {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.data-item {
  background: linear-gradient(135deg, #f8faff 0%, #f0f7ff 100%);
  padding: 20rpx 28rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
}

.data-label {
  font-size: 30rpx;
  color: #555;
  margin-right: 14rpx;
  font-weight: 600;
}

.data-value {
  font-size: 30rpx;
  color: #1a1a1a;
  font-weight: 700;
}

/* 模态框 - 大字体 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.65);
  z-index: 100;
}

.modal-content {
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 88%;
  background: #fff;
  border-radius: 32rpx;
  z-index: 101;
  box-shadow: 0 24rpx 72rpx rgba(0, 0, 0, 0.25);
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 40rpx;
  border-bottom: 2rpx solid #f0f0f0;
}

.modal-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #1a1a1a;
}

.modal-close {
  font-size: 52rpx;
  color: #888;
  line-height: 1;
  padding: 0 14rpx;
}

.modal-body {
  padding: 40rpx;
  max-height: 640rpx;
  overflow-y: auto;
}

.form-item {
  display: flex;
  align-items: center;
  margin-bottom: 32rpx;
  padding: 24rpx 28rpx;
  background: #f8faff;
  border-radius: 20rpx;
}

.form-label {
  width: 140rpx;
  font-size: 36rpx;
  color: #444;
  font-weight: 600;
}

.form-input {
  flex: 1;
  font-size: 36rpx;
  color: #1a1a1a;
  padding: 0 18rpx;
}

.form-unit {
  font-size: 30rpx;
  color: #666;
  margin-left: 14rpx;
}

.modal-footer {
  padding: 0 40rpx 40rpx;
}

.submit-btn {
  width: 100%;
  height: 112rpx;
  background: linear-gradient(135deg, #43D97C 0%, #38F9D7 100%);
  color: #fff;
  font-size: 36rpx;
  font-weight: 700;
  border-radius: 28rpx;
  box-shadow: 0 10rpx 36rpx rgba(67, 217, 124, 0.4);
  letter-spacing: 1rpx;
}

.submit-btn::after {
  border: none;
}

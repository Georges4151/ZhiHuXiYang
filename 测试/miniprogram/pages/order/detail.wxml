<view class="container">
  <view class="status-header status-{{order.status}}">
    <view class="status-icon">
      <text wx:if="{{order.status === 0}}">⏳</text>
      <text wx:elif="{{order.status === 1}}">✅</text>
      <text wx:elif="{{order.status === 2}}">🔧</text>
      <text wx:elif="{{order.status === 3}}">✓</text>
      <text wx:else>❌</text>
    </view>
    <text class="status-text">{{statusText}}</text>
    <text class="status-desc">{{statusDesc}}</text>
  </view>

  <view class="service-card">
    <view class="card-header">
      <text class="card-title">服务信息</text>
    </view>
    <view class="service-info">
      <view class="info-row">
        <text class="info-label">服务名称</text>
        <text class="info-value">{{order.serviceName}}</text>
      </view>
      <view class="info-row">
        <text class="info-label">服务金额</text>
        <text class="info-value price">¥{{order.amount}}</text>
      </view>
      <view class="info-row">
        <text class="info-label">预约时间</text>
        <text class="info-value">{{order.appointmentTime}}</text>
      </view>
      <view class="info-row">
        <text class="info-label">服务地址</text>
        <text class="info-value">{{order.serviceAddress}}</text>
      </view>
    </view>
  </view>

  <view class="contact-card">
    <view class="card-header">
      <text class="card-title">联系信息</text>
    </view>
    <view class="contact-info">
      <view class="info-row">
        <text class="info-label">联系人</text>
        <text class="info-value">{{order.contactName}}</text>
      </view>
      <view class="info-row">
        <text class="info-label">联系电话</text>
        <text class="info-value phone" bindtap="makePhoneCall">{{order.contactPhone}}</text>
      </view>
    </view>
  </view>

  <view class="order-card">
    <view class="card-header">
      <text class="card-title">订单信息</text>
    </view>
    <view class="order-info">
      <view class="info-row">
        <text class="info-label">订单编号</text>
        <view class="info-value-wrap">
          <text class="info-value">{{order.orderNo}}</text>
          <text class="copy-btn" bindtap="copyOrderNo">复制</text>
        </view>
      </view>
      <view class="info-row">
        <text class="info-label">下单时间</text>
        <text class="info-value">{{order.createTime}}</text>
      </view>
      <view class="info-row" wx:if="{{order.updateTime}}">
        <text class="info-label">更新时间</text>
        <text class="info-value">{{order.updateTime}}</text>
      </view>
      <view class="info-row" wx:if="{{order.remark}}">
        <text class="info-label">备注</text>
        <text class="info-value">{{order.remark}}</text>
      </view>
    </view>
  </view>

  <view class="timeline-section" wx:if="{{timeline.length > 0}}">
    <view class="card-header">
      <text class="card-title">订单进度</text>
    </view>
    <view class="timeline-list">
      <view class="timeline-item {{index === 0 ? 'active' : ''}}" wx:for="{{timeline}}" wx:key="time">
        <view class="timeline-dot"></view>
        <view class="timeline-content">
          <text class="timeline-title">{{item.title}}</text>
          <text class="timeline-time">{{item.time}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 支付状态显示 -->
  <view class="pay-status-card" wx:if="{{order.payStatus !== undefined}}">
    <view class="card-header">
      <text class="card-title">支付状态</text>
    </view>
    <view class="pay-status-info">
      <view class="info-row">
        <text class="info-label">支付状态</text>
        <text class="info-value {{order.payStatus === 1 ? 'paid' : 'unpaid'}}">{{order.payStatus === 1 ? '已支付' : '未支付'}}</text>
      </view>
      <view class="info-row" wx:if="{{order.payTime}}">
        <text class="info-label">支付时间</text>
        <text class="info-value">{{order.payTime}}</text>
      </view>
    </view>
  </view>

  <view class="bottom-bar" wx:if="{{order.status === 0 || order.status === 1 || order.status === 2}}">
    <button class="cancel-btn" wx:if="{{order.status === 0}}" bindtap="cancelOrder">取消订单</button>
    <button class="pay-btn" wx:if="{{order.status === 0 && order.payStatus === 0}}" bindtap="payOrder">立即支付</button>
    <button class="confirm-btn" wx:if="{{order.status === 2}}" bindtap="completeOrder">确认完成</button>
    <button class="contact-btn" bindtap="makePhoneCall">联系客服</button>
  </view>
</view>

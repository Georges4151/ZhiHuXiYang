/* 订单列表样式 - 现代温馨风格 */
.container {
  min-height: 100vh;
  background: linear-gradient(180deg, #f0f5ff 0%, #f8fafc 50%, #f5f7fa 100%);
}

/* 标签页 */
.tabs {
  display: flex;
  background: #fff;
  padding: 24rpx 30rpx;
  position: sticky;
  top: 0;
  z-index: 10;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  font-size: 32rpx;
  color: #64748b;
  position: relative;
  font-weight: 500;
  transition: all 0.3s ease;
}

.tab-item:active {
  transform: scale(0.95);
}

.tab-item.active {
  color: #667eea;
  font-weight: 600;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 48rpx;
  height: 6rpx;
  background: linear-gradient(90deg, #667eea 0%, #764ba2 100%);
  border-radius: 3rpx;
}

/* 订单列表 */
.order-list {
  padding: 30rpx;
}

.order-item {
  background: #fff;
  border-radius: 28rpx;
  padding: 30rpx;
  margin-bottom: 28rpx;
  box-shadow: 0 6rpx 24rpx rgba(0, 0, 0, 0.06);
  transition: all 0.3s ease;
}

.order-item:active {
  transform: translateY(-4rpx);
  box-shadow: 0 10rpx 35rpx rgba(0, 0, 0, 0.1);
}

.order-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-bottom: 24rpx;
  border-bottom: 1rpx solid #f1f5f9;
}

.order-no {
  font-size: 28rpx;
  color: #94a3b8;
  font-weight: 500;
}

.order-status {
  font-size: 32rpx;
  font-weight: 700;
  padding: 8rpx 18rpx;
  border-radius: 20rpx;
}

.order-status[data-status="0"] {
  background: linear-gradient(135deg, #fef3c7 0%, #fde68a 100%);
  color: #d97706;
}

.order-status[data-status="1"] {
  background: linear-gradient(135deg, #e0e7ff 0%, #c7d2fe 100%);
  color: #4f46e5;
}

.order-status[data-status="2"] {
  background: linear-gradient(135deg, #d1fae5 0%, #a7f3d0 100%);
  color: #059669;
}

.order-status[data-status="3"] {
  background: #f1f5f9;
  color: #64748b;
}

.order-content {
  display: flex;
  align-items: center;
  padding: 28rpx 0;
}

.service-icon {
  width: 110rpx;
  height: 110rpx;
  background: linear-gradient(135deg, #f0f5ff 0%, #e0e7ff 100%);
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
  margin-right: 24rpx;
  box-shadow: 0 4rpx 15rpx rgba(102, 126, 234, 0.15);
}

.service-info {
  flex: 1;
}

.service-name {
  font-size: 34rpx;
  font-weight: 700;
  color: #1e293b;
  display: block;
  margin-bottom: 12rpx;
}

.service-time {
  font-size: 28rpx;
  color: #64748b;
  font-weight: 500;
}

.service-price {
  text-align: right;
}

.price-label {
  font-size: 28rpx;
  color: #94a3b8;
  display: block;
  font-weight: 500;
}

.price-value {
  font-size: 40rpx;
  font-weight: 700;
  color: #f59e0b;
}

.order-footer {
  padding-top: 24rpx;
  border-top: 1rpx solid #f1f5f9;
}

.order-time {
  font-size: 28rpx;
  color: #94a3b8;
  display: block;
  font-weight: 500;
}

.order-actions-wrap {
  display: flex;
  justify-content: flex-end;
  gap: 20rpx;
  margin-top: 20rpx;
}

.order-actions {
  display: flex;
  gap: 20rpx;
}

.action-btn {
  padding: 16rpx 32rpx;
  font-size: 28rpx;
  border-radius: 32rpx;
  margin: 0;
  font-weight: 600;
  transition: all 0.3s ease;
}

.action-btn:active {
  transform: scale(0.95);
}

.action-btn.cancel {
  background: #fff;
  color: #64748b;
  border: 2rpx solid #e2e8f0;
}

.action-btn.pay {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  box-shadow: 0 6rpx 20rpx rgba(102, 126, 234, 0.35);
}

.action-btn.complete {
  background: linear-gradient(135deg, #43e97b 0%, #38f9d7 100%);
  color: #fff;
  box-shadow: 0 6rpx 20rpx rgba(67, 233, 123, 0.35);
}

.action-btn.detail {
  background: #fff;
  color: #667eea;
  border: 2rpx solid #667eea;
}

/* 空状态 */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 60rpx;
}

.empty-icon {
  font-size: 100rpx;
  margin-bottom: 30rpx;
  opacity: 0.7;
}

.empty-text {
  font-size: 30rpx;
  color: #94a3b8;
  font-weight: 500;
}

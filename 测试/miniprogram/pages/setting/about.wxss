.container {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 120rpx;
}

.header {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 0;
  background: linear-gradient(135deg, #4A90D9 0%, #357ABD 100%);
}

.logo {
  width: 120rpx;
  height: 120rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 60rpx;
  margin-bottom: 20rpx;
}

.app-name {
  font-size: 36rpx;
  color: #fff;
  font-weight: 500;
  margin-bottom: 8rpx;
}

.version {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
}

.info-section {
  background: #fff;
  margin-top: 20rpx;
  padding: 30rpx;
}

.info-label {
  display: block;
  font-size: 30rpx;
  color: #333;
  font-weight: 500;
  margin-bottom: 16rpx;
}

.info-content {
  font-size: 28rpx;
  color: #666;
  line-height: 1.8;
}

.list-section {
  background: #fff;
  margin-top: 20rpx;
}

.list-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.list-item:last-child {
  border-bottom: none;
}

.list-label {
  font-size: 30rpx;
  color: #333;
}

.list-right {
  display: flex;
  align-items: center;
}

.list-value {
  font-size: 28rpx;
  color: #666;
  margin-right: 12rpx;
}

.copy-btn {
  font-size: 24rpx;
  color: #4A90D9;
  padding: 8rpx 16rpx;
  background: rgba(74, 144, 217, 0.1);
  border-radius: 8rpx;
}

.arrow {
  font-size: 32rpx;
  color: #ccc;
}

.footer {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 30rpx;
}

.copyright {
  font-size: 26rpx;
  color: #999;
  margin-bottom: 12rpx;
}

.icp {
  font-size: 24rpx;
  color: #ccc;
}

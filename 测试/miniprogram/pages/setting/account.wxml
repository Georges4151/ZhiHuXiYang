<view class="container">
  <view class="avatar-section">
    <view class="avatar-wrap">
      <view class="avatar-default">
        <text class="avatar-icon">👤</text>
      </view>
    </view>
    <text class="avatar-name">{{userInfo.name || '用户'}}</text>
  </view>

  <view class="info-section">
    <view class="section-title">基本信息</view>
    <view class="info-list">
      <view class="info-item" bindtap="goToEdit" data-type="profile">
        <view class="info-left">
          <text class="info-label">昵称</text>
        </view>
        <view class="info-right">
          <text class="info-value">{{userInfo.name || '未设置'}}</text>
          <text class="arrow">›</text>
        </view>
      </view>
      <view class="info-item">
        <view class="info-left">
          <text class="info-label">性别</text>
        </view>
        <view class="info-right">
          <text class="info-value">{{genderText}}</text>
        </view>
      </view>
      <view class="info-item">
        <view class="info-left">
          <text class="info-label">生日</text>
        </view>
        <view class="info-right">
          <text class="info-value">{{userInfo.birthday || '未设置'}}</text>
        </view>
      </view>
    </view>
  </view>

  <view class="info-section">
    <view class="section-title">安全设置</view>
    <view class="info-list">
      <view class="info-item" bindtap="goToEdit" data-type="password">
        <view class="info-left">
          <text class="info-label">修改密码</text>
        </view>
        <view class="info-right">
          <text class="arrow">›</text>
        </view>
      </view>
    </view>
  </view>

  <view class="info-section">
    <view class="section-title">紧急联系人</view>
    <view class="info-list">
      <view class="info-item" bindtap="goToEdit" data-type="emergency">
        <view class="info-left">
          <text class="info-label">联系人</text>
        </view>
        <view class="info-right">
          <text class="info-value">{{userInfo.emergencyContact || '未设置'}}</text>
          <text class="arrow">›</text>
        </view>
      </view>
      <view class="info-item">
        <view class="info-left">
          <text class="info-label">联系电话</text>
        </view>
        <view class="info-right">
          <text class="info-value">{{userInfo.emergencyPhone || '未设置'}}</text>
        </view>
      </view>
    </view>
  </view>

  <view class="info-section">
    <view class="section-title">健康信息</view>
    <view class="info-list">
      <view class="info-item" bindtap="goToEdit" data-type="health">
        <view class="info-left">
          <text class="info-label">健康状况</text>
        </view>
        <view class="info-right">
          <text class="info-value {{userInfo.healthCondition ? '' : 'placeholder'}}">{{userInfo.healthCondition || '点击设置'}}</text>
          <text class="arrow">›</text>
        </view>
      </view>
    </view>
  </view>

  <view class="logout-section">
    <button class="logout-btn" bindtap="logout">退出登录</button>
  </view>
</view>

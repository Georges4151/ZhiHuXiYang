.container {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 120rpx;
}

.service-header {
  display: flex;
  align-items: center;
  padding: 30rpx;
  background: #fff;
}

.service-icon {
  width: 120rpx;
  height: 120rpx;
  background: linear-gradient(135deg, #f0f7ff 0%, #e6f0ff 100%);
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 60rpx;
  margin-right: 24rpx;
}

.service-info {
  flex: 1;
}

.service-name {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  display: block;
  margin-bottom: 12rpx;
}

.service-meta {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.service-category {
  font-size: 28rpx;
  color: #fff;
  background: #4A90D9;
  padding: 4rpx 16rpx;
  border-radius: 16rpx;
}

.service-rating {
  font-size: 28rpx;
  color: #FFB800;
}

.service-sales {
  font-size: 28rpx;
  color: #999;
}

.price-section {
  background: #fff;
  margin-top: 20rpx;
  padding: 24rpx 30rpx;
}

.price-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.price-label {
  font-size: 28rpx;
  color: #666;
}

.price-value {
  display: flex;
  align-items: baseline;
}

.price-unit {
  font-size: 28rpx;
  color: #FF6B6B;
}

.price-num {
  font-size: 48rpx;
  font-weight: bold;
  color: #FF6B6B;
}

.duration-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 20rpx;
}

.duration-label {
  font-size: 28rpx;
  color: #666;
}

.duration-value {
  font-size: 28rpx;
  color: #333;
}

.detail-section {
  background: #fff;
  margin-top: 20rpx;
  padding: 30rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
  padding-left: 16rpx;
  border-left: 6rpx solid #4A90D9;
}

.section-content {
  font-size: 28rpx;
  color: #666;
  line-height: 1.8;
}

.service-items {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.service-item {
  display: flex;
  align-items: center;
}

.item-icon {
  width: 36rpx;
  height: 36rpx;
  background: #52C41A;
  color: #fff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  margin-right: 16rpx;
}

.item-text {
  font-size: 28rpx;
  color: #666;
}

.notice-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.notice-item {
  font-size: 28rpx;
  color: #999;
  line-height: 1.6;
}

.review-summary {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.review-score {
  font-size: 48rpx;
  font-weight: bold;
  color: #FFB800;
  margin-right: 16rpx;
}

.review-desc {
  font-size: 28rpx;
  color: #666;
}

.review-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.review-item {
  padding: 20rpx;
  background: #f9f9f9;
  border-radius: 12rpx;
}

.review-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.review-user {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.review-time {
  font-size: 28rpx;
  color: #999;
}

.review-stars {
  margin-bottom: 12rpx;
}

.review-content {
  font-size: 28rpx;
  color: #666;
  line-height: 1.6;
}

.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  padding: 20rpx 30rpx;
  background: #fff;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.05);
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
}

.contact-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 0 30rpx;
}

.contact-icon {
  font-size: 40rpx;
}

.contact-text {
  font-size: 24rpx;
  color: #666;
  margin-top: 4rpx;
}

.order-btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  background: linear-gradient(135deg, #4A90D9 0%, #357ABD 100%);
  color: #fff;
  font-size: 32rpx;
  border-radius: 44rpx;
  margin-left: 20rpx;
}

.order-btn::after {
  border: none;
}

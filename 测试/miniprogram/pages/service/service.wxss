/* 服务页面样式 - 现代温馨风格 */
.container {
  min-height: 100vh;
  background: linear-gradient(180deg, #f0f5ff 0%, #f8fafc 50%, #f5f7fa 100%);
  padding-bottom: 140rpx;
}

/* 头部区域 */
.header {
  position: relative;
}

.header-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 240rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 50%, #f093fb 100%);
  border-radius: 0 0 50rpx 50rpx;
  box-shadow: 0 10rpx 40rpx rgba(102, 126, 234, 0.3);
}

.header-bg::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100"><circle cx="80" cy="20" r="40" fill="rgba(255,255,255,0.1)"/><circle cx="20" cy="80" r="30" fill="rgba(255,255,255,0.08)"/></svg>');
  background-size: 200rpx;
  opacity: 0.5;
}

.header-content {
  position: relative;
  padding: 60rpx 40rpx 40rpx;
  color: #fff;
}

.header-title {
  font-size: 44rpx;
  font-weight: 700;
  display: block;
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.1);
}

.header-desc {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.85);
  margin-top: 12rpx;
  display: block;
}

/* 分类滚动区域 */
.category-scroll {
  margin: -30rpx 0 30rpx;
  position: relative;
  z-index: 1;
}

.category-list {
  white-space: nowrap;
  padding: 20rpx 30rpx;
}

.category-item {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 32rpx;
  margin-right: 20rpx;
  background: #fff;
  border-radius: 24rpx;
  box-shadow: 0 6rpx 20rpx rgba(0, 0, 0, 0.08);
  transition: all 0.3s ease;
  border: 2rpx solid transparent;
}

.category-item:active {
  transform: scale(0.95);
}

.category-item.active {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  box-shadow: 0 8rpx 30rpx rgba(102, 126, 234, 0.35);
  border-color: rgba(255, 255, 255, 0.3);
}

.category-icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 12rpx;
  box-shadow: 0 6rpx 20rpx rgba(0, 0, 0, 0.15);
  position: relative;
  overflow: hidden;
}

.category-icon::after {
  content: '';
  position: absolute;
  top: -50%;
  left: -50%;
  width: 200%;
  height: 200%;
  background: linear-gradient(135deg, rgba(255,255,255,0.25) 0%, transparent 50%);
  transform: rotate(45deg);
}

.category-icon-text {
  font-size: 48rpx;
  font-weight: 800;
  color: #fff;
  text-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.25);
  z-index: 1;
}

.category-item.active .category-icon {
  background: rgba(255, 255, 255, 0.25);
  box-shadow: none;
}

.category-item.active .category-icon-text {
  color: #fff;
}

.category-name {
  font-size: 28rpx;
  color: #475569;
  font-weight: 500;
}

.category-item.active .category-name {
  color: #fff;
}

/* 服务列表 */
.service-list {
  padding: 0 30rpx;
}

.service-item {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 28rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 6rpx 24rpx rgba(0, 0, 0, 0.06);
  transition: all 0.3s ease;
}

.service-item:active {
  transform: translateY(-4rpx);
  box-shadow: 0 10rpx 35rpx rgba(0, 0, 0, 0.1);
}

.service-left {
  margin-right: 24rpx;
}

.service-icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 6rpx 20rpx rgba(0, 0, 0, 0.15);
  position: relative;
  overflow: hidden;
}

.service-icon::after {
  content: '';
  position: absolute;
  top: -50%;
  left: -50%;
  width: 200%;
  height: 200%;
  background: linear-gradient(135deg, rgba(255,255,255,0.25) 0%, transparent 50%);
  transform: rotate(45deg);
}

.service-icon-text {
  font-size: 48rpx;
  font-weight: 800;
  color: #fff;
  text-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.25);
  z-index: 1;
}

.service-content {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.service-header {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.service-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #1e293b;
}

.service-tag {
  margin-left: 16rpx;
  padding: 6rpx 16rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  font-size: 24rpx;
  border-radius: 12rpx;
  font-weight: 500;
}

.service-desc {
  font-size: 28rpx;
  color: #64748b;
  line-height: 1.5;
  margin-bottom: 16rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.service-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.service-meta {
  display: flex;
  gap: 20rpx;
}

.service-rating {
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.rating-text {
  font-size: 24rpx;
  color: #f59e0b;
}

.rating-value {
  font-size: 24rpx;
  color: #f59e0b;
  font-weight: 600;
}

.service-sales {
  font-size: 24rpx;
  color: #94a3b8;
}

.service-price-wrap {
  display: flex;
  align-items: baseline;
}

.service-price {
  font-size: 40rpx;
  font-weight: 700;
  color: #f59e0b;
}

.service-unit {
  font-size: 24rpx;
  color: #94a3b8;
  margin-left: 4rpx;
}

.order-btn {
  width: 130rpx;
  height: 68rpx;
  line-height: 68rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 34rpx;
  padding: 0;
  margin-left: 20rpx;
  box-shadow: 0 6rpx 20rpx rgba(102, 126, 234, 0.35);
  transition: all 0.3s ease;
}

.order-btn:active {
  transform: scale(0.95);
  box-shadow: 0 4rpx 12rpx rgba(102, 126, 234, 0.25);
}

/* 空状态 */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 60rpx;
}

.empty-icon-wrap {
  width: 160rpx;
  height: 160rpx;
  background: linear-gradient(135deg, #e8f4ff 0%, #dcebff 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 30rpx;
}

.empty-icon-text {
  font-size: 60rpx;
  font-weight: 800;
  color: #4A90D9;
  opacity: 0.7;
}

.empty-text {
  font-size: 30rpx;
  color: #94a3b8;
  font-weight: 500;
}

/* 悬浮按钮 */
.float-btn {
  position: fixed;
  right: 30rpx;
  bottom: 200rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  background: linear-gradient(135deg, #43e97b 0%, #38f9d7 100%);
  padding: 24rpx 28rpx;
  border-radius: 50rpx;
  box-shadow: 0 10rpx 35rpx rgba(67, 233, 123, 0.4);
  transition: all 0.3s ease;
  z-index: 100;
}

.float-btn:active {
  transform: scale(0.95);
  box-shadow: 0 6rpx 20rpx rgba(67, 233, 123, 0.3);
}

.float-icon-wrap {
  width: 56rpx;
  height: 56rpx;
  background: rgba(255, 255, 255, 0.3);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 8rpx;
}

.float-icon-text {
  font-size: 22rpx;
  color: #fff;
  font-weight: 600;
}

.float-text {
  font-size: 24rpx;
  color: #fff;
  font-weight: 600;
}

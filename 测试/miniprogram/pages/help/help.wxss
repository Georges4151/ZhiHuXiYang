.container {
  min-height: 100vh;
  background: linear-gradient(180deg, #f0f5ff 0%, #f5f7fa 100%);
  padding-bottom: 40rpx;
}

.header {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 30rpx;
  background: linear-gradient(135deg, #4A90D9 0%, #6BA3E0 100%);
  border-radius: 0 0 40rpx 40rpx;
  margin-bottom: 30rpx;
}

.header-icon {
  font-size: 100rpx;
  margin-bottom: 20rpx;
}

.header-title {
  font-size: 48rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 12rpx;
}

.header-subtitle {
  font-size: 32rpx;
  color: rgba(255, 255, 255, 0.8);
}

.help-list {
  padding: 0 20rpx;
}

.help-section {
  background: #fff;
  border-radius: 20rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx;
}

.section-left {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.section-icon {
  font-size: 44rpx;
}

.section-title {
  font-size: 38rpx;
  font-weight: bold;
  color: #333;
}

.section-arrow {
  font-size: 44rpx;
  color: #999;
  transition: transform 0.3s;
}

.section-arrow.expanded {
  transform: rotate(90deg);
}

.section-content {
  padding: 0 32rpx 32rpx;
  border-top: 1rpx solid #f0f0f0;
}

.help-item {
  padding: 28rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.help-item:last-child {
  border-bottom: none;
}

.question {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.q-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 48rpx;
  height: 48rpx;
  background: linear-gradient(135deg, #4A90D9 0%, #6BA3E0 100%);
  color: #fff;
  font-size: 28rpx;
  font-weight: bold;
  border-radius: 10rpx;
  flex-shrink: 0;
}

.q-text {
  font-size: 34rpx;
  font-weight: 500;
  color: #333;
  line-height: 1.6;
}

.answer {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
}

.a-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 48rpx;
  height: 48rpx;
  background: linear-gradient(135deg, #67C23A 0%, #85D462 100%);
  color: #fff;
  font-size: 28rpx;
  font-weight: bold;
  border-radius: 10rpx;
  flex-shrink: 0;
}

.a-text {
  font-size: 32rpx;
  color: #666;
  line-height: 1.8;
}

.contact-section {
  padding: 30rpx 20rpx;
}

.contact-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 40rpx;
  text-align: center;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.contact-title {
  display: block;
  font-size: 38rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 12rpx;
}

.contact-desc {
  display: block;
  font-size: 30rpx;
  color: #999;
  margin-bottom: 30rpx;
}

.contact-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  width: 100%;
  height: 96rpx;
  background: linear-gradient(135deg, #4A90D9 0%, #6BA3E0 100%);
  color: #fff;
  font-size: 34rpx;
  border-radius: 16rpx;
  border: none;
}

.contact-btn::after {
  display: none;
}

.contact-icon {
  font-size: 40rpx;
}

.footer {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 0;
}

.version {
  font-size: 28rpx;
  color: #999;
  margin-bottom: 8rpx;
}

.copyright {
  font-size: 26rpx;
  color: #ccc;
}

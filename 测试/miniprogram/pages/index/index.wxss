/* 首页样式 - 适老化设计版本 */
/* 设计原则：大字体、高对比度、高识别度、温馨风格 */

.container {
  min-height: 100vh;
  background: linear-gradient(180deg, #f0f7ff 0%, #ffffff 50%, #f8faff 100%);
  padding-bottom: 220rpx;
}

/* 头部区域 - 更大更醒目 */
.header {
  position: relative;
  padding-top: 0;
}

.header-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 340rpx;
  background: linear-gradient(135deg, #4A90D9 0%, #357ABD 50%, #5BA0E8 100%);
  border-radius: 0 0 48rpx 48rpx;
  box-shadow: 0 12rpx 48rpx rgba(74, 144, 217, 0.35);
}

.header-bg::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100"><circle cx="85" cy="15" r="45" fill="rgba(255,255,255,0.12)"/><circle cx="15" cy="85" r="35" fill="rgba(255,255,255,0.08)"/></svg>');
  background-size: 220rpx;
  opacity: 0.6;
}

.header-content {
  position: relative;
  padding: 70rpx 40rpx 40rpx;
}

.header-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.welcome {
  display: flex;
  flex-direction: column;
}

.greeting {
  font-size: 52rpx;
  font-weight: 700;
  color: #fff;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.15);
  letter-spacing: 2rpx;
}

.sub-greeting {
  font-size: 36rpx;
  color: rgba(255, 255, 255, 0.95);
  margin-top: 14rpx;
  font-weight: 400;
  letter-spacing: 1rpx;
}

/* 轮播图 - 更大更醒目 */
.banner-wrapper {
  position: relative;
  margin: 32rpx;
}

.banner {
  height: 300rpx;
  border-radius: 32rpx;
  overflow: hidden;
  box-shadow: 0 16rpx 48rpx rgba(74, 144, 217, 0.25);
}

.banner-item {
  width: 100%;
  height: 100%;
  position: relative;
  display: flex;
  align-items: center;
  padding: 0 56rpx;
}

.banner-content {
  display: flex;
  flex-direction: column;
  z-index: 1;
}

.banner-title {
  font-size: 48rpx;
  font-weight: 700;
  color: #fff;
  margin-bottom: 18rpx;
  text-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.2);
  letter-spacing: 2rpx;
}

.banner-desc {
  font-size: 34rpx;
  color: rgba(255, 255, 255, 0.95);
  letter-spacing: 1rpx;
}

.banner-decoration {
  position: absolute;
  right: 50rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.25);
}

.banner-dots {
  display: flex;
  justify-content: center;
  gap: 14rpx;
  margin-top: 24rpx;
}

.dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: rgba(74, 144, 217, 0.35);
  transition: all 0.3s ease;
}

.dot.active {
  width: 40rpx;
  border-radius: 8rpx;
  background: linear-gradient(135deg, #4A90D9 0%, #357ABD 100%);
}

/* 紧急呼救 - 更大更醒目 */
.emergency-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin: 32rpx;
  padding: 48rpx 40rpx;
  background: linear-gradient(135deg, #fff5f5 0%, #fff 100%);
  border-radius: 32rpx;
  box-shadow: 0 10rpx 36rpx rgba(245, 108, 108, 0.18);
  border: 2rpx solid rgba(245, 108, 108, 0.15);
}

.emergency-btn {
  position: relative;
  width: 180rpx;
  height: 180rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #F56C6C 0%, #E64545 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 12rpx 40rpx rgba(245, 108, 108, 0.45);
}

.pulse-ring {
  position: absolute;
  width: 100%;
  height: 100%;
  border-radius: 50%;
  border: 5rpx solid rgba(245, 108, 108, 0.7);
  animation: pulse 2s ease-out infinite;
}

.pulse-ring.delay {
  animation-delay: 1s;
}

@keyframes pulse {
  0% {
    transform: scale(1);
    opacity: 1;
  }
  100% {
    transform: scale(1.5);
    opacity: 0;
  }
}

.emergency-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  z-index: 1;
}

.emergency-icon-text {
  font-size: 48rpx;
  font-weight: 900;
  color: #fff;
  letter-spacing: 4rpx;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.3);
}

.emergency-text {
  font-size: 28rpx;
  color: #fff;
  font-weight: 700;
  margin-top: 10rpx;
  letter-spacing: 2rpx;
}

.emergency-desc {
  margin-top: 24rpx;
  font-size: 30rpx;
  color: #666;
  font-weight: 500;
}

/* 功能区域 - 更大触摸区域 */
.function-section {
  margin: 24rpx 32rpx;
  background: #fff;
  border-radius: 32rpx;
  padding: 40rpx;
  box-shadow: 0 10rpx 36rpx rgba(0, 0, 0, 0.08);
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 32rpx;
}

.section-title {
  font-size: 38rpx;
  font-weight: 700;
  color: #1a1a1a;
  display: flex;
  align-items: center;
  letter-spacing: 1rpx;
}

.section-title::before {
  content: '';
  width: 8rpx;
  height: 36rpx;
  background: linear-gradient(180deg, #4A90D9 0%, #357ABD 100%);
  border-radius: 4rpx;
  margin-right: 18rpx;
}

.function-grid {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.function-item {
  display: flex;
  align-items: center;
  padding: 28rpx;
  background: linear-gradient(135deg, #f8faff 0%, #f0f7ff 100%);
  border-radius: 24rpx;
  transition: all 0.3s ease;
  min-height: 120rpx;
}

.function-item:active {
  background: linear-gradient(135deg, #e8f4ff 0%, #dcebff 100%);
  transform: scale(0.99);
}

.function-icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 6rpx 20rpx rgba(0, 0, 0, 0.15);
  position: relative;
  overflow: hidden;
}

.function-icon::after {
  content: '';
  position: absolute;
  top: -50%;
  left: -50%;
  width: 200%;
  height: 200%;
  background: linear-gradient(135deg, rgba(255,255,255,0.25) 0%, transparent 50%);
  transform: rotate(45deg);
}

.icon-letter {
  font-size: 48rpx;
  font-weight: 800;
  color: #fff;
  text-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.25);
  z-index: 1;
}

.function-info {
  flex: 1;
  margin-left: 28rpx;
  display: flex;
  flex-direction: column;
}

.function-name {
  font-size: 34rpx;
  font-weight: 600;
  color: #1a1a1a;
  letter-spacing: 1rpx;
}

.function-desc {
  font-size: 28rpx;
  color: #666;
  margin-top: 8rpx;
}

.function-arrow {
  width: 18rpx;
  height: 18rpx;
  border-top: 4rpx solid #999;
  border-right: 4rpx solid #999;
  transform: rotate(45deg);
}

/* 天气区域 - 更清晰显示 */
.weather-section {
  margin: 24rpx 32rpx;
}

.weather-card {
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, #4A90D9 0%, #357ABD 100%);
  border-radius: 32rpx;
  padding: 40rpx;
  box-shadow: 0 14rpx 48rpx rgba(74, 144, 217, 0.35);
}

.weather-left {
  display: flex;
  align-items: center;
  flex: 1;
}

.weather-icon-wrap {
  width: 100rpx;
  height: 100rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
}

.weather-icon-big {
  font-size: 60rpx;
}

.weather-detail {
  display: flex;
  flex-direction: column;
}

.weather-temp-big {
  font-size: 56rpx;
  font-weight: 700;
  color: #fff;
  letter-spacing: 1rpx;
}

.weather-status {
  font-size: 30rpx;
  color: rgba(255, 255, 255, 0.95);
  margin-top: 10rpx;
  font-weight: 500;
}

.weather-right {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.weather-item {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.weather-label {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.8);
}

.weather-value {
  font-size: 28rpx;
  color: #fff;
  font-weight: 600;
}

.weather-arrow {
  width: 18rpx;
  height: 18rpx;
  border-top: 4rpx solid rgba(255, 255, 255, 0.7);
  border-right: 4rpx solid rgba(255, 255, 255, 0.7);
  transform: rotate(45deg);
  margin-left: 24rpx;
}

.city-switch {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 24rpx;
  padding: 20rpx;
  background: #fff;
  border-radius: 20rpx;
  box-shadow: 0 6rpx 16rpx rgba(0, 0, 0, 0.06);
}

.switch-icon-wrap {
  width: 56rpx;
  height: 56rpx;
  background: linear-gradient(135deg, #4A90D9 0%, #357ABD 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 12rpx;
}

.switch-icon-text {
  font-size: 22rpx;
  color: #fff;
  font-weight: 600;
}

.switch-text {
  font-size: 30rpx;
  color: #4A90D9;
  font-weight: 600;
}

/* 新闻区域 - 大字体高对比 */
.news-section {
  margin: 24rpx 32rpx 32rpx;
  background: #fff;
  border-radius: 32rpx;
  padding: 40rpx;
  box-shadow: 0 10rpx 36rpx rgba(0, 0, 0, 0.08);
}

.section-more {
  display: flex;
  align-items: center;
  font-size: 30rpx;
  color: #4A90D9;
  font-weight: 600;
}

.more-arrow {
  width: 14rpx;
  height: 14rpx;
  border-top: 4rpx solid #4A90D9;
  border-right: 4rpx solid #4A90D9;
  transform: rotate(45deg);
  margin-left: 10rpx;
}

.news-list {
  display: flex;
  flex-direction: column;
  gap: 28rpx;
}

.news-item {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  padding: 28rpx;
  background: linear-gradient(135deg, #f8faff 0%, #f0f7ff 100%);
  border-radius: 24rpx;
  transition: all 0.3s ease;
  min-height: 140rpx;
}

.news-item:active {
  background: linear-gradient(135deg, #e8f4ff 0%, #dcebff 100%);
  transform: scale(0.99);
}

.news-content {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.news-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1a1a1a;
  line-height: 1.6;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  margin-bottom: 14rpx;
  letter-spacing: 1rpx;
}

.news-summary {
  font-size: 28rpx;
  color: #555;
  line-height: 1.5;
  display: -webkit-box;
  -webkit-line-clamp: 1;
  -webkit-box-orient: vertical;
  overflow: hidden;
  margin-bottom: 14rpx;
}

.news-meta {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.news-time {
  font-size: 26rpx;
  color: #888;
}

.news-views {
  font-size: 26rpx;
  color: #888;
}

.news-tag {
  font-size: 26rpx;
  color: #4A90D9;
  background: rgba(74, 144, 217, 0.12);
  padding: 10rpx 18rpx;
  border-radius: 12rpx;
  font-weight: 600;
  margin-left: 18rpx;
  flex-shrink: 0;
}

/* 底部信息 */
.footer {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 36rpx;
  margin-top: 24rpx;
}

.footer-text {
  font-size: 30rpx;
  color: #888;
  text-align: center;
  font-weight: 500;
}

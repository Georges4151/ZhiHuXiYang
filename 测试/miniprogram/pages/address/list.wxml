<view class="container">
  <view class="header">
    <view class="header-bg"></view>
    <view class="header-content">
      <text class="header-title">地址管理</text>
      <text class="header-desc">管理您的服务地址</text>
    </view>
  </view>

  <view class="address-list" wx:if="{{addressList.length > 0}}">
    <view class="address-item" wx:for="{{addressList}}" wx:key="id" bindtap="selectAddress" data-item="{{item}}">
      <view class="address-header">
        <view class="user-info">
          <text class="name">{{item.name}}</text>
          <text class="phone">{{item.phone}}</text>
        </view>
        <view class="tag {{item.isDefault ? 'default' : ''}}" wx:if="{{item.label}}">
          {{item.label}}
        </view>
      </view>
      
      <view class="address-content">
        <view class="default-badge" wx:if="{{item.isDefault}}">默认</view>
        <text class="address-text">{{item.province}}{{item.city}}{{item.district}}{{item.detail}}</text>
      </view>

      <view class="address-actions">
        <view class="action-btn" catchtap="setDefault" data-id="{{item.id}}" wx:if="{{!item.isDefault}}">
          <text>⭐ 设为默认</text>
        </view>
        <view class="action-btn edit" catchtap="goToEdit" data-id="{{item.id}}">
          <text>✏️ 编辑</text>
        </view>
        <view class="action-btn delete" catchtap="deleteAddress" data-id="{{item.id}}">
          <text>🗑️ 删除</text>
        </view>
      </view>
    </view>
  </view>

  <view class="empty" wx:if="{{addressList.length === 0 && !loading}}">
    <text class="empty-icon">📍</text>
    <text class="empty-text">暂无地址</text>
    <text class="empty-desc">点击下方按钮添加地址</text>
  </view>

  <view class="loading" wx:if="{{loading}}">
    <view class="loading-spinner"></view>
    <text>加载中...</text>
  </view>

  <view class="add-btn" bindtap="goToAdd">
    <text class="add-icon">+</text>
    <text>添加新地址</text>
  </view>
</view>

.container {
  min-height: 100vh;
  background: linear-gradient(180deg, #f0f5ff 0%, #f5f7fa 100%);
  padding-bottom: 140rpx;
}

.header {
  position: relative;
}

.header-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 200rpx;
  background: linear-gradient(135deg, #E6A23C 0%, #D48806 100%);
  border-radius: 0 0 60rpx 60rpx;
}

.header-content {
  position: relative;
  padding: 40rpx 30rpx 30rpx;
  color: #fff;
}

.header-title {
  font-size: 40rpx;
  font-weight: bold;
  display: block;
}

.header-desc {
  font-size: 26rpx;
  opacity: 0.8;
  margin-top: 10rpx;
  display: block;
}

.address-list {
  padding: 30rpx;
}

.address-item {
  background: #fff;
  border-radius: 24rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.address-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.user-info {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.phone {
  font-size: 28rpx;
  color: #666;
}

.tag {
  padding: 6rpx 16rpx;
  background: linear-gradient(135deg, #f0f5ff 0%, #e6f0ff 100%);
  color: #4A90D9;
  font-size: 22rpx;
  border-radius: 16rpx;
}

.tag.default {
  background: linear-gradient(135deg, #fef0e6 0%, #fde2c4 100%);
  color: #E6A23C;
}

.address-content {
  display: flex;
  align-items: flex-start;
  margin-bottom: 20rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.default-badge {
  padding: 4rpx 12rpx;
  background: linear-gradient(135deg, #E6A23C 0%, #D48806 100%);
  color: #fff;
  font-size: 20rpx;
  border-radius: 8rpx;
  margin-right: 12rpx;
  flex-shrink: 0;
}

.address-text {
  font-size: 28rpx;
  color: #666;
  line-height: 1.5;
}

.address-actions {
  display: flex;
  gap: 20rpx;
}

.action-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 16rpx;
  border-radius: 16rpx;
  font-size: 26rpx;
  background: #f5f7fa;
  color: #666;
}

.action-btn.edit {
  background: linear-gradient(135deg, #f0f5ff 0%, #e6f0ff 100%);
  color: #4A90D9;
}

.action-btn.delete {
  background: linear-gradient(135deg, #fef0f0 0%, #fde2e2 100%);
  color: #F56C6C;
}

.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx;
}

.empty-icon {
  font-size: 100rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 32rpx;
  color: #333;
  margin-bottom: 10rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: #999;
}

.loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx;
  color: #999;
  font-size: 26rpx;
}

.loading-spinner {
  width: 40rpx;
  height: 40rpx;
  border: 4rpx solid #eee;
  border-top-color: #E6A23C;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin-bottom: 16rpx;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.add-btn {
  position: fixed;
  left: 30rpx;
  right: 30rpx;
  bottom: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 28rpx;
  background: linear-gradient(135deg, #E6A23C 0%, #D48806 100%);
  border-radius: 24rpx;
  color: #fff;
  font-size: 32rpx;
  box-shadow: 0 8rpx 30rpx rgba(230, 162, 60, 0.3);
}

.add-icon {
  font-size: 36rpx;
  margin-right: 12rpx;
  font-weight: bold;
}

<view class="container">
  <view class="chat-container">
    <scroll-view 
      class="message-list" 
      scroll-y 
      scroll-top="{{scrollTop}}"
      scroll-with-animation
    >
      <view class="message-item {{item.role}}" wx:for="{{messages}}" wx:key="id">
        <view class="avatar">
          <image wx:if="{{item.role === 'assistant'}}" src="/images/icon/robot.png" mode="aspectFill"></image>
          <image wx:else src="{{userInfo.avatar || '/images/icon/user.png'}}" mode="aspectFill"></image>
        </view>
        <view class="message-content">
          <view class="message-text">{{item.content}}</view>
          <view class="message-time">{{item.time}}</view>
        </view>
      </view>
      
      <view class="typing-indicator" wx:if="{{isTyping}}">
        <view class="avatar">
          <image src="/images/icon/robot.png" mode="aspectFill"></image>
        </view>
        <view class="typing-content">
          <view class="typing-dots">
            <view class="dot"></view>
            <view class="dot"></view>
            <view class="dot"></view>
          </view>
        </view>
      </view>
    </scroll-view>

    <view class="quick-questions">
      <view class="quick-title">常见问题</view>
      <view class="quick-list">
        <view class="quick-item" bindtap="onQuickQuestion" data-question="养老金如何计算？">养老金计算</view>
        <view class="quick-item" bindtap="onQuickQuestion" data-question="老年人医保报销比例是多少？">医保报销</view>
        <view class="quick-item" bindtap="onQuickQuestion" data-question="居家养老服务有哪些？">居家服务</view>
      </view>
    </view>

    <view class="input-area">
      <input 
        class="message-input" 
        type="text" 
        placeholder="请输入您的问题..." 
        value="{{inputValue}}"
        bindinput="onInputChange"
        confirm-type="send"
        bindconfirm="sendMessage"
      />
      <button class="send-btn" bindtap="sendMessage" disabled="{{isTyping || !inputValue}}">
        发送
      </button>
      <button class="clear-btn" bindtap="clearChat">清空</button>
    </view>
  </view>
</view>

.container {
  min-height: 100vh;
  background: #fff;
  padding-bottom: 40rpx;
}

.article-header {
  padding: 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.article-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
  line-height: 1.4;
  display: block;
  margin-bottom: 20rpx;
}

.article-meta {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.meta-category {
  font-size: 28rpx;
  color: #fff;
  background: #4A90D9;
  padding: 4rpx 16rpx;
  border-radius: 16rpx;
}

.meta-time {
  font-size: 28rpx;
  color: #999;
}

.meta-views {
  font-size: 28rpx;
  color: #999;
}

.article-content {
  padding: 30rpx;
}

.content-text {
  font-size: 32rpx;
  color: #333;
  line-height: 1.8;
  text-align: justify;
}

.related-section {
  padding: 30rpx;
  background: #f9f9f9;
  margin-top: 20rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.related-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.related-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx;
  background: #fff;
  border-radius: 12rpx;
}

.related-title {
  flex: 1;
  font-size: 32rpx;
  color: #333;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.related-time {
  font-size: 28rpx;
  color: #999;
  margin-left: 20rpx;
}

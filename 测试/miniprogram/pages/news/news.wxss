/* 新闻页面样式 - 现代温馨风格 */
.container {
  min-height: 100vh;
  background: linear-gradient(180deg, #f0f5ff 0%, #f8fafc 50%, #f5f7fa 100%);
  padding-bottom: 40rpx;
}

/* 头部区域 */
.header {
  position: relative;
}

.header-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 240rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 50%, #f093fb 100%);
  border-radius: 0 0 50rpx 50rpx;
  box-shadow: 0 10rpx 40rpx rgba(102, 126, 234, 0.3);
}

.header-bg::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100"><circle cx="80" cy="20" r="40" fill="rgba(255,255,255,0.1)"/><circle cx="20" cy="80" r="30" fill="rgba(255,255,255,0.08)"/></svg>');
  background-size: 200rpx;
  opacity: 0.5;
}

.header-content {
  position: relative;
  padding: 60rpx 40rpx 50rpx;
  color: #fff;
}

.header-title {
  font-size: 44rpx;
  font-weight: 700;
  display: block;
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.1);
}

.header-desc {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.85);
  margin-top: 12rpx;
  display: block;
}

/* 分类标签 */
.category-tabs {
  display: flex;
  background: #fff;
  margin: -30rpx 30rpx 30rpx;
  border-radius: 28rpx;
  padding: 12rpx;
  box-shadow: 0 6rpx 24rpx rgba(0, 0, 0, 0.08);
  position: relative;
  z-index: 1;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 22rpx 0;
  font-size: 32rpx;
  color: #64748b;
  border-radius: 20rpx;
  transition: all 0.3s ease;
  font-weight: 500;
}

.tab-item:active {
  transform: scale(0.95);
}

.tab-item.active {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  font-weight: 600;
  box-shadow: 0 6rpx 20rpx rgba(102, 126, 234, 0.35);
}

/* 新闻列表 */
.news-list {
  padding: 0 30rpx;
}

.news-item {
  background: #fff;
  border-radius: 28rpx;
  padding: 35rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 6rpx 24rpx rgba(0, 0, 0, 0.06);
  transition: all 0.3s ease;
}

.news-item:active {
  transform: translateY(-4rpx);
  box-shadow: 0 10rpx 35rpx rgba(0, 0, 0, 0.1);
}

.news-content {
  display: flex;
  flex-direction: column;
}

.news-header {
  display: flex;
  align-items: flex-start;
  margin-bottom: 20rpx;
}

.news-title {
  flex: 1;
  font-size: 34rpx;
  font-weight: 700;
  color: #1e293b;
  line-height: 1.4;
}

.top-tag {
  padding: 6rpx 16rpx;
  background: linear-gradient(135deg, #ff6b6b 0%, #ee5a5a 100%);
  color: #fff;
  font-size: 24rpx;
  border-radius: 12rpx;
  margin-left: 16rpx;
  flex-shrink: 0;
  font-weight: 600;
  box-shadow: 0 4rpx 12rpx rgba(255, 107, 107, 0.3);
}

.news-summary {
  font-size: 32rpx;
  color: #64748b;
  line-height: 1.6;
  margin-bottom: 24rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  font-weight: 500;
}

.news-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.news-meta {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.news-category {
  padding: 8rpx 18rpx;
  background: linear-gradient(135deg, #f0f5ff 0%, #e0e7ff 100%);
  color: #667eea;
  font-size: 28rpx;
  border-radius: 16rpx;
  font-weight: 600;
}

.news-time {
  font-size: 28rpx;
  color: #94a3b8;
  font-weight: 500;
}

.news-views {
  font-size: 28rpx;
  color: #94a3b8;
  font-weight: 500;
}

/* 加载状态 */
.loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 50rpx;
  color: #94a3b8;
  font-size: 32rpx;
  font-weight: 500;
}

.loading-spinner {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid #e2e8f0;
  border-top-color: #667eea;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin-bottom: 20rpx;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

/* 没有更多 */
.no-more {
  text-align: center;
  padding: 50rpx;
  color: #94a3b8;
  font-size: 28rpx;
  font-weight: 500;
}

/* 空状态 */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 60rpx;
}

.empty-icon {
  font-size: 100rpx;
  margin-bottom: 30rpx;
  opacity: 0.7;
}

.empty-text {
  font-size: 30rpx;
  color: #94a3b8;
  font-weight: 500;
}

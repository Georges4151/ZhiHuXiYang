/* 活动列表样式 - 现代温馨风格 */
.container {
  min-height: 100vh;
  background: linear-gradient(180deg, #f0f5ff 0%, #f8fafc 50%, #f5f7fa 100%);
  padding-bottom: 40rpx;
}

/* 头部区域 */
.header {
  position: relative;
  padding: 50rpx 40rpx;
  margin-bottom: 30rpx;
}

.header-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 240rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 50%, #f093fb 100%);
  border-radius: 0 0 50rpx 50rpx;
  box-shadow: 0 10rpx 40rpx rgba(102, 126, 234, 0.3);
}

.header-bg::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100"><circle cx="80" cy="20" r="40" fill="rgba(255,255,255,0.1)"/><circle cx="20" cy="80" r="30" fill="rgba(255,255,255,0.08)"/></svg>');
  background-size: 200rpx;
  opacity: 0.5;
}

.header-content {
  position: relative;
  z-index: 1;
  padding-top: 30rpx;
}

.header-title {
  display: block;
  font-size: 48rpx;
  font-weight: 700;
  color: #fff;
  margin-bottom: 12rpx;
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.1);
}

.header-subtitle {
  display: block;
  font-size: 32rpx;
  color: rgba(255, 255, 255, 0.85);
}

/* 分类区域 */
.categories {
  background: #fff;
  padding: 24rpx 0;
  margin: -20rpx 30rpx 30rpx;
  border-radius: 28rpx;
  box-shadow: 0 6rpx 24rpx rgba(0, 0, 0, 0.08);
  position: relative;
  z-index: 1;
}

.category-scroll {
  white-space: nowrap;
  padding: 0 24rpx;
}

.category-item {
  display: inline-block;
  padding: 20rpx 40rpx;
  margin: 0 12rpx;
  font-size: 32rpx;
  color: #64748b;
  background: #f8fafc;
  border-radius: 32rpx;
  transition: all 0.3s ease;
  font-weight: 500;
}

.category-item:active {
  transform: scale(0.95);
}

.category-item.active {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  box-shadow: 0 6rpx 20rpx rgba(102, 126, 234, 0.35);
}

/* 活动列表 */
.activity-list {
  padding: 0 30rpx;
}

.activity-card {
  background: #fff;
  border-radius: 28rpx;
  margin-bottom: 28rpx;
  overflow: hidden;
  box-shadow: 0 6rpx 24rpx rgba(0, 0, 0, 0.06);
  transition: all 0.3s ease;
}

.activity-card:active {
  transform: translateY(-6rpx);
  box-shadow: 0 12rpx 40rpx rgba(0, 0, 0, 0.1);
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 28rpx 20rpx;
}

.category-tag {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 10rpx 20rpx;
  background: linear-gradient(135deg, #f0f5ff 0%, #e8f4ff 100%);
  border-radius: 24rpx;
}

.category-icon {
  font-size: 32rpx;
}

.category-name {
  font-size: 28rpx;
  color: #667eea;
  font-weight: 600;
}

.status-tag {
  padding: 10rpx 20rpx;
  border-radius: 24rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.status-tag.active {
  background: linear-gradient(135deg, #d1fae5 0%, #a7f3d0 100%);
  color: #059669;
}

.status-tag.ended {
  background: #f1f5f9;
  color: #94a3b8;
}

.card-body {
  padding: 0 28rpx 24rpx;
}

.activity-title {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: #1e293b;
  margin-bottom: 16rpx;
  line-height: 1.4;
}

.activity-desc {
  display: block;
  font-size: 32rpx;
  color: #64748b;
  line-height: 1.6;
  margin-bottom: 24rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.activity-info {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.info-item {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.info-icon {
  font-size: 32rpx;
}

.info-text {
  font-size: 32rpx;
  color: #64748b;
  font-weight: 500;
}

.card-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 28rpx;
  border-top: 1rpx solid #f1f5f9;
  background: linear-gradient(180deg, #fff 0%, #f8fafc 100%);
}

.participants {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.avatar-group {
  display: flex;
}

.avatar-group .avatar {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  border: 3rpx solid #fff;
  margin-left: -18rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

.avatar-group .avatar:first-child {
  margin-left: 0;
}

.participants-text {
  font-size: 28rpx;
  color: #64748b;
  font-weight: 500;
}

.interactions {
  display: flex;
  gap: 28rpx;
}

.interaction-item {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.interaction-icon {
  font-size: 32rpx;
}

.interaction-count {
  font-size: 28rpx;
  color: #94a3b8;
  font-weight: 500;
}

.progress-bar {
  height: 8rpx;
  background: #f1f5f9;
  border-radius: 0 0 28rpx 28rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #667eea 0%, #764ba2 100%);
  transition: width 0.5s ease;
  border-radius: 0 4rpx 4rpx 0;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 60rpx;
}

.empty-icon {
  font-size: 100rpx;
  margin-bottom: 30rpx;
  opacity: 0.7;
}

.empty-text {
  font-size: 32rpx;
  color: #94a3b8;
  font-weight: 500;
}

/* 加载状态 */
.loading-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 60rpx;
}

.loading-spinner {
  width: 64rpx;
  height: 64rpx;
  border: 4rpx solid #e2e8f0;
  border-top-color: #667eea;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

.loading-text {
  margin-top: 24rpx;
  font-size: 32rpx;
  color: #94a3b8;
  font-weight: 500;
}

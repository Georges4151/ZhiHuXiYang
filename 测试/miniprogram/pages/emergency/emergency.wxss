/* 急救页面样式 - 现代温馨风格 */
.container {
  min-height: 100vh;
  background: linear-gradient(180deg, #fff0f0 0%, #f5f7fa 100%);
  padding-bottom: 40rpx;
}

.header {
  position: relative;
}

.header-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 200rpx;
  background: linear-gradient(135deg, #FF6B6B 0%, #EE5A5A 100%);
  border-radius: 0 0 60rpx 60rpx;
  box-shadow: 0 8rpx 30rpx rgba(255, 107, 107, 0.3);
}

.header-bg::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100"><circle cx="80" cy="20" r="40" fill="rgba(255,255,255,0.1)"/><circle cx="20" cy="80" r="30" fill="rgba(255,255,255,0.08)"/></svg>');
  background-size: 200rpx;
  opacity: 0.5;
}

.header-content {
  position: relative;
  padding: 50rpx 30rpx 30rpx;
  color: #fff;
}

.header-title {
  font-size: 44rpx;
  font-weight: 700;
  display: block;
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.1);
}

.header-desc {
  font-size: 28rpx;
  opacity: 0.9;
  margin-top: 12rpx;
  display: block;
}

/* 紧急呼叫区域 */
.emergency-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 50rpx 0 40rpx;
}

.emergency-btn {
  position: relative;
  width: 260rpx;
  height: 260rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #FF6B6B 0%, #EE5A5A 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 16rpx 60rpx rgba(255, 107, 107, 0.5);
}

.emergency-btn.disabled {
  opacity: 0.7;
}

.pulse-ring {
  position: absolute;
  width: 100%;
  height: 100%;
  border-radius: 50%;
  border: 4rpx solid rgba(255, 107, 107, 0.4);
  animation: pulse 2s infinite;
}

.pulse-ring.delay {
  animation-delay: 0.5s;
}

.pulse-ring.delay2 {
  animation-delay: 1s;
}

@keyframes pulse {
  0% {
    transform: scale(1);
    opacity: 1;
  }
  100% {
    transform: scale(1.6);
    opacity: 0;
  }
}

.emergency-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  z-index: 1;
}

.emergency-icon-text {
  font-size: 64rpx;
  font-weight: 900;
  color: #fff;
  letter-spacing: 6rpx;
  text-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.3);
}

.emergency-text {
  font-size: 32rpx;
  font-weight: 700;
  color: #fff;
  margin-top: 16rpx;
  letter-spacing: 2rpx;
}

.emergency-tip {
  font-size: 26rpx;
  color: #999;
  margin-top: 30rpx;
}

/* 通用区块 */
.section {
  margin: 0 30rpx 30rpx;
  background: #fff;
  border-radius: 28rpx;
  padding: 32rpx;
  box-shadow: 0 6rpx 24rpx rgba(0, 0, 0, 0.06);
}

.section-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #333;
  margin-bottom: 28rpx;
  display: flex;
  align-items: center;
}

.section-title::before {
  content: '';
  width: 8rpx;
  height: 32rpx;
  background: linear-gradient(180deg, #FF6B6B 0%, #EE5A5A 100%);
  border-radius: 4rpx;
  margin-right: 16rpx;
}

/* 快速拨号 */
.quick-actions {
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
}

.action-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 28rpx 16rpx;
  background: linear-gradient(135deg, #f8faff 0%, #f0f7ff 100%);
  border-radius: 20rpx;
  transition: all 0.3s ease;
}

.action-item:active {
  transform: scale(0.96);
  background: linear-gradient(135deg, #e8f4ff 0%, #dcebff 100%);
}

.action-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 16rpx;
  box-shadow: 0 6rpx 20rpx rgba(0, 0, 0, 0.15);
  position: relative;
  overflow: hidden;
}

.action-icon::after {
  content: '';
  position: absolute;
  top: -50%;
  left: -50%;
  width: 200%;
  height: 200%;
  background: linear-gradient(135deg, rgba(255,255,255,0.3) 0%, transparent 50%);
  transform: rotate(45deg);
}

.action-icon-text {
  font-size: 36rpx;
  font-weight: 800;
  color: #fff;
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.2);
  z-index: 1;
}

.action-name {
  font-size: 26rpx;
  color: #333;
  margin-bottom: 8rpx;
  font-weight: 600;
}

.action-phone {
  font-size: 32rpx;
  font-weight: 700;
  color: #FF6B6B;
}

/* 联系人列表 */
.contact-list {
  
}

.contact-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.contact-item:last-child {
  border-bottom: none;
}

.contact-avatar {
  width: 88rpx;
  height: 88rpx;
  background: linear-gradient(135deg, #4A90D9 0%, #357ABD 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  box-shadow: 0 6rpx 20rpx rgba(74, 144, 217, 0.25);
}

.avatar-text {
  font-size: 40rpx;
  font-weight: 800;
  color: #fff;
}

.contact-info {
  flex: 1;
}

.contact-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #333;
  display: block;
}

.contact-relation {
  font-size: 26rpx;
  color: #999;
  margin-top: 8rpx;
  display: block;
}

.contact-action {
  padding: 16rpx 32rpx;
  background: linear-gradient(135deg, #67C23A 0%, #4A9F29 100%);
  border-radius: 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(103, 194, 58, 0.35);
}

.call-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #fff;
}

.add-contact-btn {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  background: linear-gradient(135deg, #f8faff 0%, #f0f7ff 100%);
  color: #4A90D9;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 20rpx;
  margin-top: 24rpx;
  border: 2rpx dashed #4A90D9;
}

/* 温馨提示 */
.tips-section {
  margin: 0 30rpx;
  background: #fff;
  border-radius: 28rpx;
  padding: 32rpx;
  box-shadow: 0 6rpx 24rpx rgba(0, 0, 0, 0.06);
}

.tips-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #333;
  margin-bottom: 28rpx;
  display: flex;
  align-items: center;
}

.tips-title::before {
  content: '';
  width: 8rpx;
  height: 32rpx;
  background: linear-gradient(180deg, #E6A23C 0%, #D48806 100%);
  border-radius: 4rpx;
  margin-right: 16rpx;
}

.tips-list {
  
}

.tip-item {
  display: flex;
  align-items: flex-start;
  margin-bottom: 24rpx;
}

.tip-item:last-child {
  margin-bottom: 0;
}

.tip-num {
  width: 48rpx;
  height: 48rpx;
  background: linear-gradient(135deg, #FF6B6B 0%, #EE5A5A 100%);
  color: #fff;
  font-size: 28rpx;
  font-weight: 700;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
  box-shadow: 0 4rpx 12rpx rgba(255, 107, 107, 0.3);
}

.tip-text {
  font-size: 28rpx;
  color: #666;
  line-height: 48rpx;
}

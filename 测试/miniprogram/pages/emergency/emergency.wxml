<view class="container">
  <view class="header">
    <view class="header-bg"></view>
    <view class="header-content">
      <text class="header-title">紧急呼叫</text>
      <text class="header-desc">遇到紧急情况，一键求助</text>
    </view>
  </view>

  <view class="emergency-section">
    <view class="emergency-btn {{calling ? 'disabled' : ''}}" bindtap="makeEmergencyCall">
      <view class="pulse-ring"></view>
      <view class="pulse-ring delay"></view>
      <view class="pulse-ring delay2"></view>
      <view class="emergency-content">
        <view class="emergency-icon-text">SOS</view>
        <text class="emergency-text">{{calling ? '呼叫中...' : '一键呼救'}}</text>
      </view>
    </view>
    <text class="emergency-tip">点击后将通知紧急联系人和社区服务人员</text>
  </view>

  <view class="section">
    <view class="section-title">快速拨号</view>
    <view class="quick-actions">
      <view class="action-item" wx:for="{{quickActions}}" wx:key="id" bindtap="callPhone" data-phone="{{item.phone}}">
        <view class="action-icon" style="background: {{item.color}}">
          <text class="action-icon-text">{{item.name.charAt(0)}}</text>
        </view>
        <text class="action-name">{{item.name}}</text>
        <text class="action-phone">{{item.phone}}</text>
      </view>
    </view>
  </view>

  <view class="section">
    <view class="section-title">紧急联系人</view>
    <view class="contact-list">
      <view class="contact-item" wx:for="{{emergencyContacts}}" wx:key="id" bindtap="callPhone" data-phone="{{item.phone}}">
        <view class="contact-avatar">
          <text class="avatar-text">{{item.name.charAt(0)}}</text>
        </view>
        <view class="contact-info">
          <text class="contact-name">{{item.name}}</text>
          <text class="contact-relation">{{item.relation}}</text>
        </view>
        <view class="contact-action">
          <text class="call-text">拨打</text>
        </view>
      </view>
    </view>
    <button class="add-contact-btn" bindtap="addContact">+ 添加联系人</button>
  </view>

  <view class="tips-section">
    <view class="tips-title">温馨提示</view>
    <view class="tips-list">
      <view class="tip-item">
        <view class="tip-num">1</view>
        <text class="tip-text">紧急情况下请保持冷静，点击一键呼救按钮</text>
      </view>
      <view class="tip-item">
        <view class="tip-num">2</view>
        <text class="tip-text">系统会自动发送您的位置信息给紧急联系人</text>
      </view>
      <view class="tip-item">
        <view class="tip-num">3</view>
        <text class="tip-text">如无法接通，请尝试拨打120急救电话</text>
      </view>
    </view>
  </view>
</view>

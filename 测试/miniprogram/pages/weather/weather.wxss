.container {
  min-height: 100vh;
  background: linear-gradient(180deg, #e8f4fd 0%, #f5f7fa 100%);
  padding-bottom: 160rpx;
}

.header {
  position: relative;
}

.header-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 200rpx;
  background: linear-gradient(135deg, #4A90D9 0%, #357ABD 100%);
  border-radius: 0 0 60rpx 60rpx;
}

.header-content {
  position: relative;
  padding: 40rpx 30rpx 30rpx;
  color: #fff;
}

.header-title {
  font-size: 40rpx;
  font-weight: bold;
  display: block;
}

.header-desc {
  font-size: 26rpx;
  opacity: 0.8;
  margin-top: 10rpx;
  display: block;
}

.current-weather {
  margin: 30rpx 30rpx 20rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 30rpx;
  box-shadow: 0 8rpx 30rpx rgba(0, 0, 0, 0.1);
}

.weather-main {
  display: flex;
  align-items: center;
  padding-bottom: 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.weather-icon {
  font-size: 120rpx;
  margin-right: 30rpx;
}

.weather-info {
  display: flex;
  flex-direction: column;
}

.temp {
  font-size: 72rpx;
  font-weight: bold;
  color: #333;
  line-height: 1;
}

.status {
  font-size: 32rpx;
  color: #666;
  margin-top: 10rpx;
}

.city {
  font-size: 26rpx;
  color: #999;
  margin-top: 8rpx;
}

.city-switch-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 20rpx 0;
  padding: 16rpx 24rpx;
  background: linear-gradient(135deg, #4A90D9 0%, #357ABD 100%);
  border-radius: 30rpx;
  width: fit-content;
  margin-left: auto;
  margin-right: auto;
}

.city-switch-btn .switch-icon {
  font-size: 28rpx;
  margin-right: 8rpx;
}

.city-switch-btn .switch-text {
  font-size: 26rpx;
  color: #fff;
  font-weight: 500;
}

.weather-details {
  display: flex;
  flex-wrap: wrap;
  padding-top: 30rpx;
}

.detail-item {
  width: 50%;
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.detail-icon {
  font-size: 32rpx;
  margin-right: 12rpx;
}

.detail-label {
  font-size: 26rpx;
  color: #999;
  width: 80rpx;
}

.detail-value {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.forecast-section {
  margin: 0 30rpx 20rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.section-header {
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.forecast-list {
  
}

.forecast-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.forecast-item:last-child {
  border-bottom: none;
}

.forecast-date {
  width: 100rpx;
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.forecast-icon {
  font-size: 40rpx;
  margin-right: 16rpx;
}

.forecast-status {
  flex: 1;
  font-size: 26rpx;
  color: #666;
}

.forecast-temp {
  display: flex;
  gap: 16rpx;
}

.temp-high {
  font-size: 28rpx;
  color: #FF6B6B;
  font-weight: bold;
}

.temp-low {
  font-size: 28rpx;
  color: #4A90D9;
  font-weight: bold;
}

.tips-section {
  margin: 0 30rpx 20rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.tips-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.tip-card {
  width: calc(50% - 10rpx);
  background: #f9f9f9;
  border-radius: 16rpx;
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.tip-icon {
  font-size: 40rpx;
  margin-bottom: 10rpx;
}

.tip-name {
  font-size: 26rpx;
  color: #666;
}

.tip-value {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-top: 8rpx;
}

.tip-desc {
  font-size: 22rpx;
  color: #999;
  margin-top: 6rpx;
  text-align: center;
}

.air-section {
  margin: 0 30rpx 20rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.air-card {
  display: flex;
  align-items: center;
}

.aqi-circle {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  margin-right: 30rpx;
  flex-shrink: 0;
}

.aqi-circle.excellent {
  background: linear-gradient(135deg, #67C23A 0%, #4A9F29 100%);
}

.aqi-circle.good {
  background: linear-gradient(135deg, #E6A23C 0%, #D48806 100%);
}

.aqi-circle.moderate {
  background: linear-gradient(135deg, #F56C6C 0%, #E64545 100%);
}

.aqi-circle.poor {
  background: linear-gradient(135deg, #909399 0%, #6B6B6B 100%);
}

.aqi-value {
  font-size: 48rpx;
  font-weight: bold;
  color: #fff;
}

.aqi-level {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
  margin-top: 6rpx;
}

.air-details {
  flex: 1;
  display: flex;
  flex-wrap: wrap;
}

.air-item {
  width: 50%;
  display: flex;
  justify-content: space-between;
  padding: 16rpx 20rpx;
  background: #f9f9f9;
  border-radius: 12rpx;
  margin-bottom: 12rpx;
  box-sizing: border-box;
}

.air-item:nth-child(odd) {
  margin-right: 12rpx;
  width: calc(50% - 6rpx);
}

.air-label {
  font-size: 26rpx;
  color: #999;
}

.air-num {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.loading-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(255, 255, 255, 0.9);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
}

.loading-content {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.loading-icon {
  font-size: 60rpx;
  animation: rotate 1s linear infinite;
}

@keyframes rotate {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

.loading-text {
  font-size: 28rpx;
  color: #666;
  margin-top: 20rpx;
}

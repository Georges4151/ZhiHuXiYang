<view class="container">
  <view class="tabs">
    <view class="tab-item {{currentTab === -1 ? 'active' : ''}}" bindtap="switchTab" data-type="-1">
      <text>全部</text>
      <view class="tab-badge" wx:if="{{unreadCount > 0}}">{{unreadCount > 99 ? '99+' : unreadCount}}</view>
    </view>
    <view class="tab-item {{currentTab === 0 ? 'active' : ''}}" bindtap="switchTab" data-type="0">
      <text>系统</text>
    </view>
    <view class="tab-item {{currentTab === 1 ? 'active' : ''}}" bindtap="switchTab" data-type="1">
      <text>服务</text>
    </view>
    <view class="tab-item {{currentTab === 2 ? 'active' : ''}}" bindtap="switchTab" data-type="2">
      <text>健康</text>
    </view>
  </view>

  <view class="action-bar" wx:if="{{unreadCount > 0}}">
    <text class="action-btn" bindtap="markAllRead">全部已读</text>
  </view>

  <view class="message-list" wx:if="{{messageList.length > 0}}">
    <view class="message-item" wx:for="{{messageList}}" wx:key="id" bindtap="goToDetail" data-id="{{item.id}}">
      <view class="message-icon">
        <text class="icon-{{item.type}}">{{typeIcons[item.type]}}</text>
      </view>
      <view class="message-content">
        <view class="message-header">
          <text class="message-title">{{item.title}}</text>
          <view class="unread-dot" wx:if="{{item.isRead === 0}}"></view>
        </view>
        <text class="message-summary">{{item.content}}</text>
        <text class="message-time">{{item.createTime}}</text>
      </view>
      <text class="arrow">›</text>
    </view>
  </view>

  <view class="empty" wx:else>
    <text class="empty-icon">📭</text>
    <text class="empty-text">暂无消息</text>
  </view>
</view>

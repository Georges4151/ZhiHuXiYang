.container {
  min-height: 100vh;
  background: linear-gradient(180deg, #f0f5ff 0%, #fff 100%);
  padding: 0 40rpx;
}

.header {
  display: flex;
  flex-direction: column;
  padding-top: 60rpx;
  margin-bottom: 40rpx;
}

.title {
  font-size: 48rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 12rpx;
}

.subtitle {
  font-size: 28rpx;
  color: #999;
}

.form-section {
  background: #fff;
  border-radius: 32rpx;
  padding: 40rpx;
  box-shadow: 0 8rpx 40rpx rgba(0, 0, 0, 0.05);
}

.form-item {
  margin-bottom: 30rpx;
}

.label {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 16rpx;
  display: block;
}

.input-wrap {
  display: flex;
  align-items: center;
  background: #f5f7fa;
  border-radius: 20rpx;
  padding: 0 24rpx;
  height: 100rpx;
}

.input-icon {
  font-size: 36rpx;
  margin-right: 16rpx;
}

.input {
  flex: 1;
  height: 100rpx;
  font-size: 30rpx;
}

.eye-btn {
  padding: 20rpx;
  margin-right: -20rpx;
}

.eye-icon {
  font-size: 36rpx;
}

.gender-group {
  display: flex;
  gap: 40rpx;
}

.gender-item {
  display: flex;
  align-items: center;
  font-size: 30rpx;
  color: #333;
}

.gender-item radio {
  margin-right: 12rpx;
}

.register-btn {
  width: 100%;
  height: 100rpx;
  line-height: 100rpx;
  background: linear-gradient(135deg, #4A90D9 0%, #357ABD 100%);
  color: #fff;
  font-size: 34rpx;
  border-radius: 20rpx;
  margin-top: 40rpx;
  box-shadow: 0 8rpx 30rpx rgba(74, 144, 217, 0.3);
}

.login-link {
  text-align: center;
  margin-top: 30rpx;
  font-size: 28rpx;
  color: #999;
}

.link {
  color: #4A90D9;
}

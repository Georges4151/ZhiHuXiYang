/* components/agent-ui/index.wxss */
.agent-ui {
  width: 750rpx;
  height: 100vh;
  position: relative;
  display: flex;
  flex-direction: column;
  overflow:hidden;
  color: #333;
  background: linear-gradient(180deg, #f0f5ff 0%, #f8fafc 100%);
  overflow: hidden;
  touch-action: none;
}

.showBotName {
  height: 62px;
}

.hiddenBotName {
  margin-top: 2px;
  margin-bottom: 2px;
}

.nav {
  width: 750rpx;
  padding: 30px 0px 20px 0px;
  display: flex;
  flex-direction: column;
  align-items: center;
  flex-shrink: 0;
}

.navBar {
  width: 100%;
  box-shadow: 0 8px 20px rgba(74, 144, 217, 0.1);
  background: linear-gradient(135deg, #4A90D9 0%, #357ABD 100%);
  border-radius: 0 0 30rpx 30rpx;
}

.tips {
  display: flex;
  align-items: center;
  gap: 12px;
  width: 100%;
  color: #999;
  font-size: 12px;
  height: 32px;
  margin-bottom: 16px;
}
.tips::before,
.tips::after {
  content: '';
  display: inline-block;
  height: 1px;
  transform: scaleY(.5);
  flex-grow: 1;
  border-radius: 2px;
}
.tips::before {
  background-image: linear-gradient(to right, rgba(74, 144, 217, 0), rgba(74, 144, 217, 0.3));
}
.tips::after {
  background-image: linear-gradient(to left, rgba(74, 144, 217, 0), rgba(74, 144, 217, 0.3));
}

.nav-content {
  display: flex;
  align-items: center;
  justify-content: space-around;
  gap: 12px;
  padding: 16rpx 0;
}

.bot-avatar {
  width: 36px;
  height: 36px;
  border-radius: 50%;
  border: 2px solid rgba(255, 255, 255, 0.8);
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
}

.bot-name {
  font-size: 18px;
  font-weight: 600;
  color: #fff;
}

.main {
  background: linear-gradient(180deg, #f0f5ff 0%, #f8fafc 100%);
  flex-grow: 1;
  position: relative;
}

.share_btn {
  background-color: transparent;
  margin: 0px !important;
  padding: 0rpx !important;
  width: 64rpx !important;
  height: 64rpx;
  border: none !important;
}

.avatar {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  box-shadow: 0 8rpx 30rpx rgba(74, 144, 217, 0.3);
}

.avatar-wrapper {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #4A90D9 0%, #357ABD 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 12rpx 40rpx rgba(74, 144, 217, 0.4);
  margin-bottom: 20rpx;
}

.avatar-emoji {
  font-size: 80rpx;
  line-height: 1;
}

.nav-title {
  font-size: 40rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 16rpx;
}

.nav-welcome {
  line-height: 1.6;
  padding: 0 40rpx;
  font-size: 28rpx;
  color: #666;
  text-align: center;
}

.chat-avatar {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #4A90D9 0%, #357ABD 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(74, 144, 217, 0.3);
}

.chat-avatar-emoji {
  font-size: 32rpx;
  line-height: 1;
}

.questions {
  margin: 0px 16px 10px 16px;
}

.question_content {
  background: linear-gradient(135deg, #e8f4fd 0%, #d6e9f8 100%);
  padding: 16rpx 28rpx;
  border-radius: 20rpx;
  display: inline-block;
  font-size: 14px;
  font-weight: 400;
  color: #4A90D9;
  box-shadow: 0 4rpx 12rpx rgba(74, 144, 217, 0.15);
}

.footer {
  width: 100%;
  min-height: 65px;
  max-height: 380px;
  flex-shrink: 0;
  position: relative;
  padding: 0px 20rpx 30px;
  box-sizing: border-box;
  background: #fff;
  border-radius: 30rpx 30rpx 0 0;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.footer .file_list {
  display: flex;
  flex-direction: row;
  flex-wrap: nowrap;
  gap: 16rpx;
  overflow-x: scroll;
  padding: 20rpx 0px;
}

.img-box {
  position: absolute;
  top: -100px;
  left: 0px;
  white-space: nowrap;
  width: 100%;
  background-color: #fff;
}

.img-preview {
  display: inline-block;
  width: 80px;
  height: 80px;
  margin-right: 8px;
  position: relative;
  margin-top: 10px;
}

.img-preview-image {
  width: 80px;
  height: 80px;
  border-radius: 16rpx;
}

.img-preview-loading {
  width: 100%;
  height: 100%;
  position: absolute;
  top: 0px;
  left: 0px;
  background-color: #f5f5f5;
  border-radius: 16rpx;
}

.img-preview-close {
  width: 16px;
  height: 16px;
  position: absolute;
  right: -8px;
  top: -8px;
}

.input_box {
  display: flex;
  align-items: flex-end;
  flex-direction: row;
  gap: 16rpx;
  position: relative;
  min-height: 40px;
  padding: 16rpx 0rpx;
  background-color: white;
  transition: all 0.3s;
}

.set_panel_modal {
  position: fixed;
  width: 750rpx;
  height: 100vh;
  left: 0px;
  top: 0px;
  background-color: rgba(0, 0, 0, 0.5);
  z-index: 1000;
}

.set_panel {
  background-color: #f8fafc;
  position: absolute;
  left: 0px;
  bottom: 0px;
  width: 750rpx;
  border-radius: 30rpx 30rpx 0 0;
}

.set_panel_funtion {
  display: flex;
  flex-direction: row;
  padding: 20rpx 24rpx;
  box-sizing: border-box;
  gap: 16rpx;
}

.set_panel_cancel {
  height: 60px;
  text-align: center;
  line-height: 40px;
  color: #666;
  border-top: #eee solid 1px;
}

.function {
  display: flex;
  width: 150rpx;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  gap: 10rpx;
  background: linear-gradient(135deg, #f0f5ff 0%, #e8f0fe 100%);
  color: #4A90D9;
  padding: 20rpx 12rpx;
  border-radius: 20rpx;
  transition: all 0.2s;
}

.function:active {
  transform: scale(0.95);
  background: linear-gradient(135deg, #e0ebfc 0%, #d8e6fd 100%);
}

.icon {
  width: 52rpx;
  height: 52rpx;
}

.text_desc {
  font-weight: 400;
  font-size: 24rpx;
  color: #4A90D9;
}

.input_inner_box {
  width: 100%;
  min-height: 54px;
  display: flex;
  align-items: center;
  border: 2rpx solid #e8f0fe;
  border-radius: 28rpx; 
  box-sizing: border-box;
  background: linear-gradient(135deg, #f8fafc 0%, #f0f5ff 100%);
}

.say_box {
  font-weight: bold;
  justify-content: center;
}

.input {
  padding: 12px 16px;
  color: #333;
  width: 100%;
  flex: 1;
  max-height: 160px;
  font-size: 16px;
}

.say_btn {
  width: 100%;
  height: 100%;
}

.right_btns {
  height: 50px;
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.left_btns {
  height: 50px;
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.set {
  width: 58rpx;
  height: 58rpx;
}

.send-set {
  width: 38rpx;
  height: 38rpx;
}

.system {
  margin-left: 24rpx;
  margin-right: 24rpx;
  border-radius: 20rpx;
  margin-top: 16px;
  padding-bottom: 16px;
  box-sizing: border-box;
  position: relative;
}
.avatar-left{
  position:absolute;
  top: 0px;
  left: 0px;
}
.guide_system {
  padding-left: 32rpx;
  padding-right: 32rpx;
  border-radius: 20rpx;
  padding-bottom: 16px;
  box-sizing: border-box;
}

.bot_intro_system {
  padding-left: 32rpx;
  padding-right: 32rpx;
  border-radius: 20rpx;
  padding-bottom: 16px;
  box-sizing: border-box;
}

.user {
  display: flex;
  justify-content: flex-end;
}

.userContent {
  margin-top: 16px;
  padding-bottom: 16px;
}

.userContent .fileBar {
  display: flex;
  flex-direction: row;
  flex-direction: row-reverse;
  flex-wrap: nowrap;
  padding: 0px 16px;
  overflow-x: scroll;
  max-height: 80px;
  gap: 10px;
  margin-top: 10px;
}

.user .user_content {
  background: linear-gradient(135deg, #4A90D9 0%, #357ABD 100%);
  border-radius: 20rpx 4rpx 20rpx 20rpx;
  margin-left: 32rpx;
  margin-right: 32rpx;
  padding: 24rpx 28rpx;
  word-wrap: break-word;
  word-break: break-all;
  font-size: 32rpx;
  color: #fff;
  position: relative;
  box-shadow: 0 4rpx 16rpx rgba(74, 144, 217, 0.3);
}

.operation-menu {
  position: absolute;
  bottom: -120rpx;
  left: 0;
  background: rgba(0, 0, 0, 0.85);
  border-radius: 12rpx;
  display: flex;
  padding: 16rpx 24rpx;
  gap: 32rpx;
  z-index: 100;
}

.operation-menu::before {
  content: '';
  position: absolute;
  top: -16rpx;
  left: 30rpx;
  border-left: 16rpx solid transparent;
  border-right: 16rpx solid transparent;
  border-bottom: 16rpx solid rgba(0, 0, 0, 0.85);
  width: 0;
  height: 0;
}

.menu-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.menu-item text {
  color: #ffffff;
  font-size: 24rpx;
}

.menu-icon {
  width: 36rpx;
  height: 36rpx;
  filter: brightness(0) invert(1);
}

.feedback_modal {
  position: fixed;
  top: 0px;
  left: 0px;
  width: 750rpx;
  height: 100vh;
  background-color: rgba(0, 0, 0, 0.5);
  display: flex;
  justify-content: center;
  align-items: center;
  z-index: 1000;
}

.modal {
  background-color: #fff;
  width: 700rpx;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 10rpx 40rpx rgba(0, 0, 0, 0.15);
}

.modal_head {
  height: 40px;
  line-height: 40px;
  padding: 0px 10px;
}

.modal_body {
  padding: 10px;
}

.modal_footer {
  display: flex;
}

.link-box {
  padding: 0px 16px 6px 16px;
}

.tool_box {
  display: flex;
  flex-direction: row;
  box-sizing: border-box;
  gap: 20rpx;
  justify-content: flex-start;
  flex-wrap: nowrap;
  overflow-x: scroll;
  padding: 20rpx 0rpx 0rpx;
}

.webSearchSwitch {
  width: 200rpx;
  height: 32px;
  display: flex;
  justify-content: center;
  align-items: center;
  border-radius: 20px;
  border: 2rpx solid rgba(74, 144, 217, 0.2);
  font-size: 14px;
  background-color: #fff;
  transition: all 0.2s;
}

.webSearchSwitch:active {
  transform: scale(0.98);
}

.feature_enable {
  background: linear-gradient(135deg, #dbeafe 0%, #c7d9f7 100%);
  color: #4A90D9;
  border-color: rgba(74, 144, 217, 0.3);
}

.feature_list {
  position: absolute;
  background-color: transparent;
  bottom: calc(100% + 20rpx);
}

.no_feature_list {
  position: absolute;
  background-color: transparent;
  bottom: calc(100%);
}


.drawer-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.4);
  z-index: 998;
  opacity: 0;
  visibility: hidden;
  transition: all 0.3s ease;
}

.drawer-mask.show {
  opacity: 1;
  visibility: visible;
}

.drawer {
  position: fixed;
  top: 0;
  left: -80%;
  width: 80%;
  height: 100vh;
  background: linear-gradient(180deg, #f8fafc 0%, #f0f5ff 100%);
  z-index: 999;
  transition: all 0.3s ease;
  display: flex;
  flex-direction: column;
}

.drawer.show {
  left: 0;
}

.drawer-header {
  padding: 20rpx 32rpx 20rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.close-icon {
  width: 24px;
  height: 24px;
}

.drawer-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  height: 0; 
  margin-bottom: 20px;
  margin-left:32rpx;
  margin-right:32rpx;
}

.con-icon {
  width: 24px;
  height: 24px;
  margin-left: 16rpx;
  margin-right: 16rpx;
}

.create-new-chat {
  border-radius: 12px;
  background: linear-gradient(135deg, #4A90D9 0%, #357ABD 100%);
  color: #fff;
  cursor: pointer;
  padding: 16rpx 28rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  box-shadow: 0 4rpx 16rpx rgba(74, 144, 217, 0.3);
}

.date-title {
  font-size: 14px;
  color: #999;
  font-weight: 500;
}

.con-container {
  margin-top: 12px;
}

.con-block {
  margin-top: 16px;
}

.con-item {
  padding: 14px 12px;
  margin-bottom: 4px;
  border-radius: 12px;
  background: #fff;
  transition: all 0.2s;
}

.con-item:active {
  transition: filter 0.4s;
  cursor: pointer;
  background-color: #f0f5ff;
  transform: scale(0.98);
}

.selected-con {
  background: linear-gradient(135deg, #e8f4fd 0%, #d6e9f8 100%);
  transition: filter 0.4s;
}

.tool_btn {
  width: 36rpx; 
  height: 36rpx;
  padding: 12rpx;
  border: 2rpx solid #e8f0fe;
  border-radius: 50%;
  background: #fff;
  transition: all 0.2s;
}

.tool_btn:active {
  background: #f0f5ff;
}

.playing_btn {
  height: 36rpx; 
  padding: 10rpx;
  border: 2rpx solid #e8f0fe;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
  position: relative;
  background: #fff;
}

.speed-switch {
  display: flex;
  align-items: center;
  margin-left: 0rpx;
  padding: 4rpx 12rpx;
  border-radius: 20rpx;
  font-size: 26rpx;
  color: #4A90D9;
  cursor: pointer;
}

.speed-label {
  margin-left: 6rpx;
}

.speed-popup {
  position: absolute;
  bottom: 48rpx;
  right: 0;
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.1);
  z-index: 99;
  padding: 8rpx 0;
  min-width: 80rpx;
}

.speed-option {
  padding: 16rpx 32rpx;
  font-size: 28rpx;
  color: #333;
  display: flex;
  align-items: center;
  justify-content: flex-start;
}

.speed-option:active {
  background: #f0f5ff;
}

.action-menu-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.4);
  z-index: 1001;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  animation: fadeIn 0.3s ease-out;
}

.action-menu {
  background: #ffffff;
  border-radius: 30rpx 30rpx 0 0;
  overflow: hidden;
  animation: slideUp 0.3s ease-out;
  margin: 0 20rpx 30rpx 20rpx;
  box-shadow: 0 -4rpx 30rpx rgba(0, 0, 0, 0.1);
}

.action-item {
  padding: 36rpx 0;
  text-align: center;
  font-size: 32rpx;
  color: #333333;
  background: #ffffff;
  border-bottom: 1rpx solid #f5f5f5;
  position: relative;
}

.action-item:last-child {
  border-bottom: none;
}

.action-item:active {
  background: #f8fafc;
}

.cancel-item {
  margin-top: 20rpx;
  border-radius: 30rpx;
  border-bottom: none;
  color: #666666;
}

@keyframes fadeIn {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

@keyframes slideUp {
  from {
    transform: translateY(100%);
  }
  to {
    transform: translateY(0);
  }
}

/* 全局样式 - 现代温馨风格 - 适老化设计 */
page {
  background-color: #f8fafc;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
  font-size: 32rpx;
  color: #1e293b;
  line-height: 1.8;
}

.container {
  min-height: 100vh;
}

/* 按钮重置 */
button {
  margin: 0;
  padding: 0;
  background: none;
  border: none;
  line-height: normal;
  font-family: inherit;
}

button::after {
  border: none;
}

/* 隐藏滚动条 */
::-webkit-scrollbar {
  display: none;
  width: 0;
  height: 0;
  color: transparent;
}

/* 通用卡片样式 */
.card {
  background: #fff;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
  overflow: hidden;
}

.card-hover {
  transform: scale(0.98);
  transition: transform 0.2s ease;
}

/* 通用标题样式 */
.section-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #1e293b;
  position: relative;
  padding-left: 28rpx;
}

.section-title::before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 8rpx;
  height: 32rpx;
  background: linear-gradient(180deg, #667eea 0%, #764ba2 100%);
  border-radius: 4rpx;
}

/* 渐变按钮 */
.btn-gradient {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  border-radius: 40rpx;
  font-weight: 600;
  box-shadow: 0 8rpx 24rpx rgba(102, 126, 234, 0.35);
  transition: all 0.3s ease;
}

.btn-gradient:active {
  transform: translateY(2rpx);
  box-shadow: 0 4rpx 12rpx rgba(102, 126, 234, 0.25);
}

/* 次要按钮 */
.btn-secondary {
  background: #f1f5f9;
  color: #475569;
  border-radius: 40rpx;
  font-weight: 500;
  transition: all 0.3s ease;
}

.btn-secondary:active {
  background: #e2e8f0;
}

/* 危险按钮 */
.btn-danger {
  background: linear-gradient(135deg, #ff6b6b 0%, #ee5a5a 100%);
  color: #fff;
  border-radius: 40rpx;
  font-weight: 600;
  box-shadow: 0 8rpx 24rpx rgba(255, 107, 107, 0.35);
}

/* 成功按钮 */
.btn-success {
  background: linear-gradient(135deg, #43e97b 0%, #38f9d7 100%);
  color: #fff;
  border-radius: 40rpx;
  font-weight: 600;
  box-shadow: 0 8rpx 24rpx rgba(67, 233, 123, 0.35);
}

/* 警告按钮 */
.btn-warning {
  background: linear-gradient(135deg, #fa709a 0%, #fee140 100%);
  color: #fff;
  border-radius: 40rpx;
  font-weight: 600;
  box-shadow: 0 8rpx 24rpx rgba(250, 112, 154, 0.35);
}

/* 输入框样式 */
.input-field {
  background: #f8fafc;
  border: 3rpx solid #e2e8f0;
  border-radius: 20rpx;
  padding: 30rpx;
  font-size: 32rpx;
  transition: all 0.3s ease;
}

.input-field:focus {
  border-color: #667eea;
  background: #fff;
  box-shadow: 0 0 0 4rpx rgba(102, 126, 234, 0.1);
}

/* 标签样式 */
.tag {
  display: inline-flex;
  align-items: center;
  padding: 12rpx 24rpx;
  border-radius: 24rpx;
  font-size: 26rpx;
  font-weight: 500;
}

.tag-primary {
  background: rgba(102, 126, 234, 0.1);
  color: #667eea;
}

.tag-success {
  background: rgba(67, 233, 123, 0.1);
  color: #10b981;
}

.tag-warning {
  background: rgba(250, 112, 154, 0.1);
  color: #f59e0b;
}

.tag-danger {
  background: rgba(255, 107, 107, 0.1);
  color: #ef4444;
}

/* 列表项样式 */
.list-item {
  display: flex;
  align-items: center;
  padding: 36rpx;
  background: #fff;
  border-bottom: 2rpx solid #f1f5f9;
  transition: background 0.2s ease;
}

.list-item:active {
  background: #f8fafc;
}

.list-item:last-child {
  border-bottom: none;
}

/* 图标容器 */
.icon-wrap {
  width: 96rpx;
  height: 96rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
}

.icon-wrap-gradient-1 {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
}

.icon-wrap-gradient-2 {
  background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
}

.icon-wrap-gradient-3 {
  background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
}

.icon-wrap-gradient-4 {
  background: linear-gradient(135deg, #43e97b 0%, #38f9d7 100%);
}

.icon-wrap-gradient-5 {
  background: linear-gradient(135deg, #fa709a 0%, #fee140 100%);
}

.icon-wrap-gradient-6 {
  background: linear-gradient(135deg, #30cfd0 0%, #330867 100%);
}

/* 动画 */
@keyframes fadeIn {
  from {
    opacity: 0;
    transform: translateY(20rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes pulse {
  0%, 100% {
    transform: scale(1);
  }
  50% {
    transform: scale(1.05);
  }
}

@keyframes shimmer {
  0% {
    background-position: -200% 0;
  }
  100% {
    background-position: 200% 0;
  }
}

.animate-fade-in {
  animation: fadeIn 0.5s ease forwards;
}

.animate-pulse {
  animation: pulse 2s ease-in-out infinite;
}

/* 骨架屏 */
.skeleton {
  background: linear-gradient(90deg, #f0f0f0 25%, #e0e0e0 50%, #f0f0f0 75%);
  background-size: 200% 100%;
  animation: shimmer 1.5s infinite;
  border-radius: 8rpx;
}

/* 安全区域 */
.safe-area-bottom {
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
}
